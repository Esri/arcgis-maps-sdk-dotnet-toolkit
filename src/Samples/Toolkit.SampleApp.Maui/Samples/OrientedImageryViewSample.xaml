<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Toolkit.SampleApp.Maui.Samples.OrientedImageryViewSample"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:esri="clr-namespace:Esri.ArcGISRuntime.Maui;assembly=Esri.ArcGISRuntime.Maui"
    xmlns:toolkit="clr-namespace:Esri.ArcGISRuntime.Toolkit.Maui;assembly=Esri.ArcGISRuntime.Toolkit.Maui"
    Title="Oriented Imagery View">
    <Grid x:Name="RootGrid" RowDefinitions="Auto,*">
        <Grid
            Grid.Row="0"
            Padding="4"
            ColumnDefinitions="*,Auto,Auto"
            ColumnSpacing="4">
            <Entry
                x:Name="LayerUriEntry"
                Grid.Column="0"
                ClearButtonVisibility="WhileEditing"
                Text="https://services.arcgis.com/2Pv4ow3pE6NFC9SW/arcgis/rest/services/EsriCampus_GoProSample/FeatureServer/0" />
            <Button
                Grid.Column="1"
                Clicked="ApplyLayerButton_Clicked"
                Text="Apply layer" />
            <Button
                x:Name="ShowDetailsButton"
                Grid.Column="2"
                Clicked="ShowDetailsButton_Clicked"
                IsEnabled="False"
                Text="Details" />
        </Grid>

        <Grid
            x:Name="ViewerGrid"
            Grid.Row="1"
            ColumnDefinitions="3*,2*"
            RowDefinitions="*,0">
            <esri:MapView x:Name="MainMapView" />
            <toolkit:OrientedImageryView
                x:Name="MainOrientedImageryView"
                Grid.Column="1"
                GeoView="{x:Reference MainMapView}" />
        </Grid>

        <Grid
            x:Name="SelectedImagePopupBackground"
            Grid.RowSpan="2"
            Padding="16"
            BackgroundColor="#AA333333"
            IsVisible="False">
            <Border
                Padding="8"
                BackgroundColor="{AppThemeBinding Dark=#202020, Light=White}"
                HorizontalOptions="Center"
                MaximumHeightRequest="600"
                MaximumWidthRequest="500"
                Stroke="{AppThemeBinding Dark=White, Light=Black}"
                VerticalOptions="Center">
                <Grid RowDefinitions="*,Auto">
                    <toolkit:PopupViewer
                        x:Name="SelectedImagePopupViewer"
                        Grid.Row="0" />
                    <Button
                        Grid.Row="1"
                        Clicked="CloseDetailsButton_Clicked"
                        Text="Close" />
                </Grid>
            </Border>
        </Grid>
    </Grid>
</ContentPage>
