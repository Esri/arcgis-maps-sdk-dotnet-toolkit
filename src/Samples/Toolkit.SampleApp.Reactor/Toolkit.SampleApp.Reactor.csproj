<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.22621.0</TargetFramework>
    <Platforms>x64;ARM64</Platforms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.1.3" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="Assets\ControlImages\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\Toolkit\Toolkit.Reactor\Esri.ArcGISRuntime.Toolkit.Reactor.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Using Static="True" Include="Esri.ArcGISRuntime.Toolkit.Reactor.Factories" />
    <Using Static="True" Include="Microsoft.UI.Reactor.Factories"/>
    <Using Include="Microsoft.UI.Reactor"/>
    <Using Include="Microsoft.UI.Reactor.Core"/>
    <Using Include="Esri.ArcGISRuntime.Mapping" />
    <Using Include="Esri.ArcGISRuntime.Toolkit.UI" />
  </ItemGroup>
</Project>
