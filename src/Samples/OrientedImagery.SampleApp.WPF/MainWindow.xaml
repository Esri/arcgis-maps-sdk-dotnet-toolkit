<Window x:Class="Esri.ArcGISRuntime.Toolkit.Samples.OrientedImagery.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:esri="http://schemas.esri.com/arcgis/runtime/2013"
        Title="Oriented imagery" Height="650" Width="1100">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="3*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="2*" />
        </Grid.ColumnDefinitions>

        <Grid Grid.Row="0" Grid.ColumnSpan="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="LayerUriTextBox" />
            <Button Grid.Column="1" Content="Add layer to geoview" Click="AddLayerButton_Click" />
            <Button Grid.Column="2" Content="2D/3D" Click="Toggle2DButton_Click" />
        </Grid>

        <Grid Grid.Row="1" Grid.Column="0">
            <Grid x:Name="GeoViewContainer" />
            <Button HorizontalAlignment="Left" VerticalAlignment="Top"
                    Content="Toggle elevation surface (3D only)" Click="ToggleElevationSurfaceButton_Click" />
        </Grid>

        <GridSplitter Grid.Row="1" Grid.Column="1" Width="5"
                      HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                      ResizeBehavior="PreviousAndNext" />
        <Grid Grid.Row="1" Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <ComboBox x:Name="SelectLayerDropdown" Text="Select Layer" SelectionChanged="SelectLayerDropdown_SelectionChanged" />
            <esri:OrientedImageryView x:Name="MainOrientedImageryView" Grid.Row="1" />
        </Grid>
    </Grid>
</Window>
