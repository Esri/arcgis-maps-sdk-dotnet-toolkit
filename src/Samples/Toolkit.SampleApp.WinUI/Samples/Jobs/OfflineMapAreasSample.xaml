<Page
    x:Class="Esri.ArcGISRuntime.Toolkit.SampleApp.Samples.Jobs.OfflineMapAreasSample"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Esri.ArcGISRuntime.Toolkit.SampleApp.Samples.Jobs"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:esri="using:Esri.ArcGISRuntime.UI.Controls"
    xmlns:tk="using:Esri.ArcGISRuntime.Toolkit.UI.Controls"
    xmlns:tasks="using:Esri.ArcGISRuntime.Tasks"
    mc:Ignorable="d">

    <Grid>

        <Grid.ColumnDefinitions>
            <ColumnDefinition />
            <ColumnDefinition Width="300" />
        </Grid.ColumnDefinitions>
        <esri:MapView Map="{x:Bind OfflineMapAreasView.OnlineMap, Mode=OneWay}" />
        <tk:OfflineMapAreasView x:Name="OfflineMapAreasView" Grid.Column="1" Margin="4" />

    </Grid>
</Page>

