<Page
    x:Class="Esri.ArcGISRuntime.Toolkit.SampleApp.Samples.OrientedImagery.OrientedImageryViewSample"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:esri="using:Esri.ArcGISRuntime.UI.Controls"
    xmlns:local="using:Esri.ArcGISRuntime.Toolkit.SampleApp.Samples.OrientedImagery"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:primitives="using:Microsoft.UI.Xaml.Controls.Primitives"
    xmlns:toolkit="using:Esri.ArcGISRuntime.Toolkit.UI.Controls"
    mc:Ignorable="d">

    <Page.Resources>
        <DataTemplate x:Key="PopupToolbarItemTemplate" x:DataType="local:OrientedImageryPopupToolbarItem">
            <Button
                Click="OpenSelectedImagePopupButton_Click"
                IsEnabled="{x:Bind local:OrientedImageryViewSample.HasSelectedImage(ViewModel.SelectedImage), Mode=OneWay}"
                ToolTipService.ToolTip="Open popup for selected image"
                AutomationProperties.Name="Open popup for selected image">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="MinWidth" Value="44" />
                        <Setter Property="MinHeight" Value="44" />
                        <Setter Property="Padding" Value="4" />
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="BorderBrush" Value="Transparent" />
                    </Style>
                </Button.Style>
                <Viewbox Width="28" Height="28" Stretch="Uniform">
                    <Grid Width="32" Height="32">
                        <Path
                            Width="32"
                            Height="32"
                            Stretch="Uniform"
                            Stroke="{ThemeResource TextFillColorPrimaryBrush}"
                            StrokeThickness="1"
                            StrokeLineJoin="Round"
                            Opacity="{x:Bind local:OrientedImageryViewSample.PopupIconOpacity(ViewModel.SelectedImage), Mode=OneWay}"
                            Data="M4 4H28V24H20L16 29L12 24H4Z M7 10H25V20H7Z M7 7H16 M24 7H25" />
                    </Grid>
                </Viewbox>
            </Button>
        </DataTemplate>
    </Page.Resources>

    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="MapColumn" Width="3*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition x:Name="ImageryColumn" Width="2*" />
        </Grid.ColumnDefinitions>

        <Grid Grid.ColumnSpan="3" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBox
                x:Name="LayerUriTextBox"
                Text="https://services.arcgis.com/2Pv4ow3pE6NFC9SW/arcgis/rest/services/EsriCampus_GoProSample/FeatureServer/0" />
            <Button
                Grid.Column="1"
                Click="ApplyLayerButton_Click"
                Content="Apply Layer" />
            <TextBlock
                x:Name="StatusTextBlock"
                Grid.Row="1"
                Grid.ColumnSpan="2"
                Margin="4"
                Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                TextWrapping="Wrap" />
        </Grid>

        <esri:MapView
            x:Name="MainMapView"
            Grid.Row="1"
            GeoViewTapped="MainMapView_GeoViewTapped" />

        <local:PanelResizeHandle
            Grid.Row="1"
            Grid.Column="1"
            Width="24"
            VerticalAlignment="Stretch">
            <primitives:Thumb
                DragDelta="PanelSplitter_DragDelta"
                AutomationProperties.Name="Resize map and imagery panels">
                <primitives:Thumb.Template>
                    <ControlTemplate TargetType="primitives:Thumb">
                        <Grid Background="Transparent">
                            <Border
                                Width="1"
                                HorizontalAlignment="Center"
                                Background="{ThemeResource ControlStrokeColorDefaultBrush}" />
                            <Border
                                Width="20"
                                Height="36"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource TextFillColorSecondaryBrush}"
                                BorderThickness="1"
                                CornerRadius="6">
                                <StackPanel
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Spacing="3">
                                    <Border Width="10" Height="2" Background="{ThemeResource TextFillColorPrimaryBrush}" />
                                    <Border Width="10" Height="2" Background="{ThemeResource TextFillColorPrimaryBrush}" />
                                    <Border Width="10" Height="2" Background="{ThemeResource TextFillColorPrimaryBrush}" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </primitives:Thumb.Template>
            </primitives:Thumb>
        </local:PanelResizeHandle>

        <toolkit:OrientedImageryView
            x:Name="MainOrientedImageryView"
            Grid.Row="1"
            Grid.Column="2"
            GeoView="{x:Bind MainMapView, Mode=OneTime}"
            ImageTapped="MainOrientedImageryView_ImageTapped" />

        <Grid
            x:Name="SelectedImagePopupBackground"
            Grid.RowSpan="2"
            Grid.ColumnSpan="3"
            Background="#AA333333"
            Tapped="SelectedImagePopupBackground_Tapped"
            Visibility="Collapsed">
            <Border
                Width="400"
                MaxHeight="500"
                Padding="5"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1">
                <toolkit:PopupViewer x:Name="SelectedImagePopupViewer" />
            </Border>
        </Grid>
    </Grid>
</Page>
