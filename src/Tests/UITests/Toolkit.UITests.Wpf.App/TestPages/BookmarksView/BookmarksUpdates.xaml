<local:TestPage
    x:Class="Toolkit.UITests.App.TestPages.BookmarksUpdates"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:esri="http://schemas.esri.com/arcgis/runtime/2013"
    xmlns:local="clr-namespace:Toolkit.UITests.App.TestPages"
    xmlns:toolkit="clr-namespace:Esri.ArcGISRuntime.Toolkit.UI.Controls;assembly=Esri.ArcGISRuntime.Toolkit.WPF">
    <Grid>
        <Grid>
            <esri:SceneView x:Name="MainSceneView" />
            <esri:MapView x:Name="MainMapView" />
        </Grid>
        <Border Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}" BorderBrush="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}" BorderThickness="1" Height="320" HorizontalAlignment="Center" Margin="8" Padding="8" VerticalAlignment="Bottom" Width="300">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="72" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock FontWeight="SemiBold" Text="Document" VerticalAlignment="Center" />
                    <Button Grid.Column="1" Margin="2" AutomationProperties.AutomationId="AddDocumentBookmarkButton" Click="AddDocumentBookmarkButton_Click" Content="Add" />
                </Grid>
                <Border Grid.Row="1" Background="Gray" Height="1" Margin="0,4" />
                <Grid Grid.Row="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock FontWeight="SemiBold" Text="Override" />
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Margin="2" AutomationProperties.AutomationId="UseOverrideButton" Click="UseOverrideButton_Click" Content="Use" />
                        <Button Grid.Column="1" Margin="2" AutomationProperties.AutomationId="AddOverrideButton" Click="AddOverrideButton_Click" Content="Add" />
                        <Button Grid.Column="2" Margin="2" AutomationProperties.AutomationId="ClearOverrideButton" Click="ClearOverrideButton_Click" Content="Clear" />
                    </Grid>
                </Grid>
                <Border Grid.Row="3" Background="Gray" Height="1" Margin="0,4" />
                <Grid Grid.Row="4">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock FontWeight="SemiBold" Text="GeoView" />
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Margin="2" AutomationProperties.AutomationId="UseMapBButton" Click="UseMapBButton_Click" Content="Map B" />
                        <Button Grid.Column="1" Margin="2" AutomationProperties.AutomationId="UseSceneButton" Click="UseSceneButton_Click" Content="Scene" />
                    </Grid>
                </Grid>
                <Border Grid.Row="5" Background="Gray" Height="1" Margin="0,4" />
                <toolkit:BookmarksView x:Name="BookmarksView" Grid.Row="6" />
            </Grid>
        </Border>
    </Grid>
</local:TestPage>