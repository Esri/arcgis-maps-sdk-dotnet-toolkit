<local:TestPage
    x:Class="Toolkit.UITests.App.TestPages.BookmarksMap"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:esri="http://schemas.esri.com/arcgis/runtime/2013"
    xmlns:local="clr-namespace:Toolkit.UITests.App.TestPages"
    xmlns:toolkit="clr-namespace:Esri.ArcGISRuntime.Toolkit.UI.Controls;assembly=Esri.ArcGISRuntime.Toolkit.WPF">
    <Grid>
        <esri:MapView x:Name="MainMapView" AutomationProperties.AutomationId="BookmarksMap" />
        <Border Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}" BorderBrush="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}" BorderThickness="1" Height="200" HorizontalAlignment="Center" Margin="8" Padding="8" VerticalAlignment="Bottom" Width="300">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="24" />
                    <RowDefinition Height="24" />
                </Grid.RowDefinitions>
                <toolkit:BookmarksView x:Name="BookmarksView" Grid.Row="0" GeoView="{Binding ElementName=MainMapView}" />
                <TextBlock x:Name="SelectedBookmarkText" Grid.Row="1" AutomationProperties.AutomationId="SelectedBookmarkText" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                <TextBlock x:Name="MapCenterText" Grid.Row="2" AutomationProperties.AutomationId="MapCenterText" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
            </Grid>
        </Border>
    </Grid>
</local:TestPage>