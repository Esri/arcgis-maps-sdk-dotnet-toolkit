        <ToggleButton IsChecked="{Binding ViewModel.ShowUnselectedFootprints}"
                      Style="{StaticResource ToolbarLabeledToggleButtonStyle}"
                      ToolTip="{internal:LocalizedString Key=OrientedImageryViewUnselectedFootprintsAutomationName}">
            <StackPanel>
                <Viewbox SnapsToDevicePixels="true" Width="30" Height="30" Stretch="Uniform">
                    <Grid Width="32" Height="32">
                        <Path SnapsToDevicePixels="true" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}" Data="M17.1999 13L22 5H0L9 20H13L13.6 19L19 28H23L32 13H17.1999ZM12.439 19H9.56103L1.7832 6H20.2168L16.0287 13H9.99999L13.0187 18.0311L12.439 19ZM22.439 27H19.561L11.7832 14H30.2168L22.439 27Z"/>
