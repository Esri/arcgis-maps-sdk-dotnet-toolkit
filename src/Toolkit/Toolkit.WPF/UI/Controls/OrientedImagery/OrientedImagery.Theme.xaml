                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ToggleButton IsChecked="{Binding IsImageSelectionEnabled}"
                          TabIndex="0" MinWidth="0" Padding="0,4"
                          Style="{StaticResource ToolbarLabeledToggleButtonStyle}"
                          AutomationProperties.Name="{internal:LocalizedString Key=OrientedImageryViewImageSearchMode}"
                          ToolTip="{internal:LocalizedString Key=OrientedImageryViewImageSearchMode}">
                <StackPanel>
                    <Viewbox Width="32" Height="32" Stretch="Uniform">
                        <ContentControl Content="{Binding SelectedInteractionState}"
                                        ContentTemplate="{StaticResource ImageSearchModeIconTemplate}"
                                        Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"
                                        Focusable="False" IsTabStop="False" />
                    </Viewbox>
                    <TextBlock Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}">
                        <TextBlock.Style>
                            <Style TargetType="{x:Type TextBlock}" BasedOn="{StaticResource ToolbarLabelStyle}">
                                <Setter Property="Width" Value="48" />
                                <Setter Property="Text" Value="{internal:LocalizedString Key=OrientedImageryViewImageSearchModeDisplay}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedInteractionState}" Value="{x:Static controls:OrientedImageryViewInteractionState.FindImages}">
                                        <Setter Property="Text" Value="{internal:LocalizedString Key=OrientedImageryViewImageSearchModeFind}" />
