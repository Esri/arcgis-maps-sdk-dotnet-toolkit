                ToolTip="{internal:LocalizedString Key=OrientedImageryViewClearMarkersLabel}">
            <StackPanel>
                <Viewbox Width="28" Height="28" Stretch="Uniform">
                    <TextBlock Text="&#xeb04;"
                               FontSize="24"
                               FontFamily="{StaticResource ToolkitIconsFontFamily}"
                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                </Viewbox>
                <TextBlock Style="{StaticResource ToolbarLabelStyle}" Text="{internal:LocalizedString Key=OrientedImageryViewClearMarkersLabel}" />
            </StackPanel>
        </Button>
    </DataTemplate>

    <DataTemplate x:Key="SequentialNavigationToolbarTemplate" DataType="controls:SequentialNavigationVM">
