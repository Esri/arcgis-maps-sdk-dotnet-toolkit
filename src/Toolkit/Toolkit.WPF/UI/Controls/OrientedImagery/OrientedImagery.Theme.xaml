    <!-- Toolbar container style -->
    <Style x:Key="OrientedImageryToolbarContainerStyle" TargetType="{x:Type ItemsControl}">
        <Setter Property="Margin" Value="8" />
        <Setter Property="ItemsPanel">
            <Setter.Value>
                <ItemsPanelTemplate>
                    <WrapPanel HorizontalAlignment="Center" Orientation="Horizontal" />
                </ItemsPanelTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <controls:OrientedImageryViewToolbarSelector x:Key="DefaultOrientedImageryToolbarSelector">
        <controls:OrientedImageryToolbarCategorySelectorPair CategoryName="{x:Static controls:OrientedImageryToolbarCategory.ModeCategoryName}"
                                                             Template="{StaticResource ToolbarCategoryTemplate}" />
        <controls:OrientedImageryToolbarCategorySelectorPair CategoryName="{x:Static controls:OrientedImageryToolbarCategory.OverlaysCategoryName}"
                                                             Template="{StaticResource ToolbarCategoryTemplate}" />
        <controls:OrientedImageryToolbarCategorySelectorPair CategoryName="{x:Static controls:OrientedImageryToolbarCategory.MarkersCategoryName}"
                                                             Template="{StaticResource ToolbarCategoryTemplate}" />
        <controls:OrientedImageryToolbarCategorySelectorPair CategoryName="{x:Static controls:OrientedImageryToolbarCategory.MoreCategoryName}"
                                                             Template="{StaticResource MoreCategoryTemplate}" />
        <controls:OrientedImageryToolbarItemSelectorPair ItemType="{x:Type controls:ToolbarDividerVM}" Template="{StaticResource ToolbarDividerTemplate}" />
        <controls:OrientedImageryToolbarItemSelectorPair ItemType="{x:Type controls:SelectNewMarkerSymbolVM}" Template="{StaticResource MarkerPickerToolbarTemplate}" />
        <controls:OrientedImageryToolbarItemSelectorPair ItemType="{x:Type controls:AllowAddingMarkersVM}" Template="{StaticResource AllowAddingMarkersToolbarTemplate}" />
        <controls:OrientedImageryToolbarItemSelectorPair ItemType="{x:Type controls:ImageSearchModeVM}" Template="{StaticResource ImageSearchModeToolbarTemplate}" />
        <controls:OrientedImageryToolbarItemSelectorPair ItemType="{x:Type controls:ShowSelectedFootprintVM}" Template="{StaticResource ShowSelectedFootprintToolbarTemplate}" />
        <controls:OrientedImageryToolbarItemSelectorPair ItemType="{x:Type controls:ShowUnselectedFootprintsVM}" Template="{StaticResource ShowUnselectedFootprintsToolbarTemplate}" />
        <controls:OrientedImageryToolbarItemSelectorPair ItemType="{x:Type controls:ShowCameraMarkersVM}" Template="{StaticResource ShowCameraMarkersToolbarTemplate}" />
        <controls:OrientedImageryToolbarItemSelectorPair ItemType="{x:Type controls:ClearMarkersVM}" Template="{StaticResource ClearMarkersToolbarTemplate}" />
        <controls:OrientedImageryToolbarItemSelectorPair ItemType="{x:Type controls:SequentialNavigationVM}" Template="{StaticResource SequentialNavigationToolbarTemplate}" />
    </controls:OrientedImageryViewToolbarSelector>

    <!-- Main view style -->
    <Style TargetType="{x:Type controls:OrientedImageryView}">
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.WindowBrushKey}}" />
        <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}" />
        <Setter Property="DisplayBackgroundColor">
            <Setter.Value>
                <Binding Path="Background.Color" RelativeSource="{RelativeSource Self}" Converter="{StaticResource ColorToColorConverter}" />
            </Setter.Value>
        </Setter>

        <Setter Property="ToolbarItemTemplateSelector" Value="{StaticResource DefaultOrientedImageryToolbarSelector}" />

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:OrientedImageryView}">
                    <Border
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <ItemsControl x:Name="PART_ToolbarContainer" IsTabStop="False" Focusable="False"
                                          ItemTemplateSelector="{StaticResource DefaultOrientedImageryToolbarSelector}">
                                <ItemsControl.Style>
                                    <Style TargetType="{x:Type ItemsControl}" BasedOn="{StaticResource OrientedImageryToolbarContainerStyle}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=ErrorMessage}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ItemsControl.Style>
                            </ItemsControl>

                            <Grid Grid.Row="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <controls:OrientedImageViewport Grid.ColumnSpan="3"
                                                               x:Name="PART_ImageViewport"
                                                               DisplayBackgroundColor="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=DisplayBackgroundColor}" />

                                <Border Grid.ColumnSpan="3"
                                        Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}">
                                    <Border.Style>
                                        <Style TargetType="{x:Type Border}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ElementName=PART_ImageViewport, Path=IsBusy}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=ViewModel.SelectedImage}" Value="{x:Null}">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               Text="{internal:LocalizedString Key=OrientedImageryViewLoading}" />
                                </Border>

                                <ProgressBar Grid.ColumnSpan="3"
                                             Height="2"
                                             VerticalAlignment="Top"
                                             IsIndeterminate="True">
                                    <ProgressBar.Style>
                                        <Style TargetType="{x:Type ProgressBar}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ElementName=PART_ImageViewport, Path=IsBusy}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=ViewModel.SelectedImage}" Value="{x:Null}">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ProgressBar.Style>
                                </ProgressBar>

                                <Border Grid.ColumnSpan="3"
                                        Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}">
                                    <Border.Style>
                                        <Style TargetType="{x:Type Border}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=ViewModel.SelectedImage}" Value="{x:Null}">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               Margin="16"
                                               MaxWidth="400"
                                               TextAlignment="Center"
                                               TextWrapping="Wrap">
                                        <TextBlock.Style>
                                            <Style TargetType="{x:Type TextBlock}">
                                                <Setter Property="Text" Value="{internal:LocalizedString Key=OrientedImageryViewNoImagesSelectedExamine}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=ViewModel.InteractionState}" Value="{x:Static controls:OrientedImageryViewInteractionState.ExploreImages}">
                                                        <Setter Property="Text" Value="{internal:LocalizedString Key=OrientedImageryViewNoImagesSelectedExplore}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=ViewModel.InteractionState}" Value="{x:Static controls:OrientedImageryViewInteractionState.None}">
                                                        <Setter Property="Text" Value="{internal:LocalizedString Key=OrientedImageryViewNoImagesSelectedNone}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Border>

                                <Popup PlacementTarget="{Binding ElementName=PART_ImageViewport}"
                                       Placement="Center"
                                       StaysOpen="True">
                                    <Popup.Style>
                                        <Style TargetType="{x:Type Popup}">
                                            <Setter Property="IsOpen" Value="True" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ElementName=PART_ImageViewport, Path=Error}" Value="{x:Null}">
                                                    <Setter Property="IsOpen" Value="False" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Popup.Style>
                                    <Border Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}"
                                            TextElement.Foreground="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}"
                                            BorderBrush="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}"
                                            BorderThickness="1"
                                            Padding="8">
                                        <TextBlock MaxWidth="300"
                                                   Text="{Binding ElementName=PART_ImageViewport, Path=Error.Message}"
                                                   TextWrapping="Wrap" />
                                    </Border>
                                </Popup>

                                <Button Style="{StaticResource ImageNavigationButtonStyle}"
                                        Command="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=ViewModel.SelectPreviousImageCommand}"
                                        ToolTip="{internal:LocalizedString Key=OrientedImageryViewPreviousImage}"
                                        VerticalAlignment="Center">
                                    <Viewbox Width="20" Height="20" Stretch="Uniform">
                                        <Grid Width="32" Height="32">
                                            <Path SnapsToDevicePixels="true" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Data="M20 26.1 9.9 16 20 5.9z">
                                                <Path.RenderTransform>
                                                    <TranslateTransform X="-3" Y="3" />
                                                </Path.RenderTransform>
                                            </Path>
                                        </Grid>
                                    </Viewbox>
                                </Button>
                                <Button Style="{StaticResource ImageNavigationButtonStyle}"
                                        Command="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=ViewModel.SelectNextImageCommand}"
                                        ToolTip="{internal:LocalizedString Key=OrientedImageryViewNextImage}"
                                        Grid.Column="2" VerticalAlignment="Center">
                                    <Viewbox Width="20" Height="20" Stretch="Uniform">
                                        <Grid Width="32" Height="32">
                                            <Path SnapsToDevicePixels="true" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Data="M12 5.9 22.1 16 12 26.1z">
                                                <Path.RenderTransform>
                                                    <TranslateTransform Y="2" />
                                                </Path.RenderTransform>
                                            </Path>
                                        </Grid>
                                    </Viewbox>
                                </Button>
                                <Button Grid.ColumnSpan="3"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Top"
                                        Margin="16"
                                        Command="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=ViewModel.OpenSelectedImagePopupCommand}"
                                        ToolTip="{internal:LocalizedString Key=OrientedImageryViewOpenSelectedImagePopup}">
                                    <Button.Style>
                                        <Style TargetType="{x:Type Button}" BasedOn="{StaticResource ImageInfoButtonStyle}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=ViewModel.SelectedImage}" Value="{x:Null}">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                    <TextBlock Text="&#xE8FA;"
                                               FontSize="20"
                                               FontFamily="{StaticResource ToolkitIconsFontFamily}"
                                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                </Button>
                            </Grid>

                            <Grid Grid.Row="1" Panel.ZIndex="2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="0.35*" />
                                    <ColumnDefinition Width="0.65*" />
                                </Grid.ColumnDefinitions>
                                <Grid.Style>
                                    <Style TargetType="{x:Type Grid}">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=ViewModel.SelectedImagePopup}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Grid.Style>
                                <Border Grid.Column="1"
                                        Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}"
                                        BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}"
                                        BorderThickness="1,0,0,0">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                        </Grid.RowDefinitions>
                                        <controls:PopupViewer Grid.Row="1"
                                                              Margin="16,0,8,8"
                                                              Popup="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=ViewModel.SelectedImagePopup}" />
                                        <Button HorizontalAlignment="Right"
                                                VerticalAlignment="Center"
                                                Margin="8"
                                                Command="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=ViewModel.CloseSelectedImagePopupCommand}"
                                                Style="{StaticResource ToolbarButtonStyle}"
                                                ToolTip="{internal:LocalizedString Key=OrientedImageryViewCloseSelectedImagePopup}">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock VerticalAlignment="Center" FontSize="16"
                                                           Text="{internal:LocalizedString Key=OrientedImageryViewCloseSelectedImagePopup}" />
                                                <TextBlock Margin="8,0,0,0" VerticalAlignment="Center"
                                                           Text="&#xeb49;" FontSize="20"
                                                           FontFamily="{StaticResource ToolkitIconsFontFamily}" />
                                            </StackPanel>
                                        </Button>
                                    </Grid>
                                </Border>
                            </Grid>

                            <Border Grid.Row="0"
                                    Grid.RowSpan="2"
                                    Padding="16"
                                    Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}"
                                    TextElement.Foreground="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}">
                                <Border.Style>
                                    <Style TargetType="{x:Type Border}">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=ErrorMessage}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           MaxWidth="400"
                                           Text="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=ErrorMessage}"
                                           TextAlignment="Center"
                                           TextWrapping="Wrap" />
                            </Border>

                            <local:Paginator x:Name="PART_Paginator" HorizontalAlignment="Center" Grid.Row="2">
                                <local:Paginator.Style>
                                    <Style TargetType="{x:Type local:Paginator}">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=ViewModel.IsSequentialNavigationEnabled}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=ViewModel.SelectedImage}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </local:Paginator.Style>
                            </local:Paginator>
                            <StackPanel Grid.Row="2"
                                        Orientation="Horizontal"
                                        HorizontalAlignment="Center">
                                <StackPanel.Style>
                                    <Style TargetType="{x:Type StackPanel}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=ViewModel.IsSequentialNavigationEnabled}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=ViewModel.SelectedImage}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <Button Style="{StaticResource PaginatorNavigationButtonStyle}"
                                        IsTabStop="False"
                                        Command="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=ViewModel.SelectPreviousImageCommand}"
                                        ToolTip="{internal:LocalizedString Key=OrientedImageryViewPreviousImage}">
                                    <TextBlock Text="&lt;" />
                                </Button>
                                <Button Content="{internal:LocalizedString Key=OrientedImageryViewPreviousLabel}"
                                        Style="{StaticResource PaginatorPageButtonStyle}"
                                        Command="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=ViewModel.SelectPreviousImageCommand}"
                                        ToolTip="{internal:LocalizedString Key=OrientedImageryViewPreviousImage}"
                                        AutomationProperties.Name="{internal:LocalizedString Key=OrientedImageryViewPreviousImage}" />
                                <Grid Width="35" Height="32">
                                    <TextBlock Text="."
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}"
                                               FontSize="14" />
                                    <Border Height="2"
                                            Margin="1,0"
                                            VerticalAlignment="Bottom"
                                            Background="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}" />
                                </Grid>
                                <Button Content="{internal:LocalizedString Key=OrientedImageryViewNextLabel}"
                                        Style="{StaticResource PaginatorPageButtonStyle}"
                                        Command="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=ViewModel.SelectNextImageCommand}"
                                        ToolTip="{internal:LocalizedString Key=OrientedImageryViewNextImage}"
                                        AutomationProperties.Name="{internal:LocalizedString Key=OrientedImageryViewNextImage}" />
                                <Button Style="{StaticResource PaginatorNavigationButtonStyle}"
                                        IsTabStop="False"
                                        Command="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=ViewModel.SelectNextImageCommand}"
                                        ToolTip="{internal:LocalizedString Key=OrientedImageryViewNextImage}">
                                    <TextBlock Text="&gt;" />
                                </Button>
                            </StackPanel>
                            <TextBlock Grid.Row="3"
                                       Text="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=ViewModel.SequentialNavigationError.Message}"
                                       Foreground="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}"
                                       TextWrapping="Wrap"
                                       TextAlignment="Center"
                                       Margin="8,0,8,4">
                                <TextBlock.Style>
                                    <Style TargetType="{x:Type TextBlock}">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=ViewModel.SequentialNavigationError}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
