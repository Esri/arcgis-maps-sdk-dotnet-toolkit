        <ToggleButton IsChecked="{Binding ViewModel.ShowCameraLocations, Mode=TwoWay}"
                      Style="{StaticResource ToolbarToggleButtonStyle}"
                      ToolTip="{internal:LocalizedString Key=OrientedImageryViewCameraLocationsAutomationName}">
            <Viewbox Width="32" Height="32" Stretch="Uniform">
                <Path Stretch="Uniform"
                      Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"
                      Data="M11 13H6V12H11V13ZM30 23.5V11.5C29.9983 10.12 28.88 9.00165 27.5 9H27C26.4479 8.99945 26.0006 8.55206 26 8C25.9989 6.89589 25.1041 6.0011 24 6H16C14.8959 6.0011 14.0011 6.89589 14 8C13.9994 8.55206 13.5521 8.99945 13 9H11V8H6V9H4.5C3.11997 9.00165 2.00165 10.12 2 11.5V23.5C2.00165 24.88 3.11997 25.9983 4.5 26H27.5C28.88 25.9983 29.9983 24.88 30 23.5ZM7 10V9H10V10H13C14.1041 9.9989 14.9989 9.10411 15 8C15.0006 7.44794 15.4479 7.00055 16 7H24C24.5521 7.00055 24.9994 7.44794 25 8C25.0011 9.10411 25.8959 9.9989 27 10H27.5C28.328 10.0011 28.9989 10.672 29 11.5V23.5C28.9989 24.328 28.328 24.9989 27.5 25H4.5C3.67203 24.9989 3.0011 24.328 3 23.5V11.5C3.0011 10.672 3.67203 10.0011 4.5 10H7ZM25.8 17C25.8 13.7967 23.2033 11.2 20 11.2C16.7967 11.2 14.2 13.7967 14.2 17C14.2 20.2033 16.7967 22.8 20 22.8C23.2019 22.7967 25.7967 20.2019 25.8 17ZM24.8 17C24.8 19.651 22.651 21.8 20 21.8C17.349 21.8 15.2 19.651 15.2 17C15.2 14.349 17.349 12.2 20 12.2C22.6498 12.2028 24.7972 14.3502 24.8 17Z" />
