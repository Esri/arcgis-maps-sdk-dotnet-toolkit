    <DataTemplate x:Key="ShowSelectedImagePopupToolbarTemplate" DataType="controls:ShowSelectedImagePopupVM">
        <Button Style="{StaticResource ToolbarLabeledButtonStyle}"
                Command="{Binding ViewModel.OpenSelectedImagePopupCommand}"
                ToolTip="{internal:LocalizedString Key=OrientedImageryViewOpenSelectedImagePopup}" >
            <StackPanel>
                <Viewbox Width="32" Height="32" Stretch="Uniform">
                    <TextBlock Text="&#xea02;"
                               FontSize="24"
                               FontFamily="{StaticResource ToolkitIconsFontFamily}"
                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                </Viewbox>
                <TextBlock Style="{StaticResource ToolbarLabelStyle}" Text="{internal:LocalizedString Key=OrientedImageryViewPopupLabel}" />
            </StackPanel>
        </Button>
    </DataTemplate>

    <DataTemplate x:Key="AllowAddingMarkersToolbarTemplate" DataType="controls:AllowAddingMarkersVM">
        <ToggleButton IsChecked="{Binding ViewModel.SketchModeEnabled}"
                      Style="{StaticResource ToolbarLabeledToggleButtonStyle}"
                      ToolTip="{internal:LocalizedString Key=OrientedImageryViewAddMarkersAutomationName}">
            <StackPanel>
                <Viewbox Width="32" Height="32" Stretch="Uniform">
                    <TextBlock Text="&#xe8ed;"
                               FontSize="24"
                               FontFamily="{StaticResource ToolkitIconsFontFamily}"
                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}" />
                </Viewbox>
                <TextBlock Style="{StaticResource ToolbarLabelStyle}" Text="{internal:LocalizedString Key=OrientedImageryViewAddMarkerLabel}" />
            </StackPanel>
        </ToggleButton>
    </DataTemplate>

    <DataTemplate x:Key="ImageSearchModeToolbarTemplate" DataType="controls:ImageSearchModeVM">
        <ComboBox ItemsSource="{Binding ImageSearchModes}"
                  SelectedItem="{Binding SelectedImageSearchMode, Mode=TwoWay}"
                  Style="{StaticResource ImageSearchModeComboBoxStyle}"
                  ToolTip="{internal:LocalizedString Key=OrientedImageryViewImageSearchMode}">
            <ComboBox.ItemContainerStyle>
                <Style TargetType="{x:Type ComboBoxItem}">
                    <Setter Property="controls:ImageSearchModeSelectionBehavior.RepeatSelection" Value="True" />
                    <Setter Property="MinHeight" Value="40" />
                    <Setter Property="Padding" Value="8,4" />
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="VerticalContentAlignment" Value="Center" />
                </Style>
            </ComboBox.ItemContainerStyle>
            <ComboBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Margin="0,0,8,0"
                                   FontSize="24"
                                   FontFamily="{StaticResource ToolkitIconsFontFamily}"
                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ComboBoxItem}}">
                            <TextBlock.Style>
                                <Style TargetType="{x:Type TextBlock}">
                                    <Setter Property="Text" Value="&#xea74;" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding}" Value="True">
                                            <Setter Property="Text" Value="&#xea72;" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBlock VerticalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="{x:Type TextBlock}">
                                    <Setter Property="Text" Value="{internal:LocalizedString Key=OrientedImageryViewImageSearchModeSelect}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding}" Value="True">
                                            <Setter Property="Text" Value="{internal:LocalizedString Key=OrientedImageryViewImageSearchModeSearch}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </DataTemplate>
            </ComboBox.ItemTemplate>
        </ComboBox>
    </DataTemplate>

    <DataTemplate x:Key="MarkerPickerToolbarTemplate" DataType="controls:SelectNewMarkerSymbolVM">
        <ComboBox ItemsSource="{Binding SymbolOptions}"
                  SelectedItem="{Binding SelectedSymbol, Mode=TwoWay}"
                  Style="{StaticResource ToolbarComboBoxStyle}"
                  Visibility="{Binding ViewModel.SketchModeEnabled, Converter={StaticResource BooleanToVisibilityConverter}}"
                  Tag="{internal:LocalizedString Key=OrientedImageryViewChooseMarkersLabel}"
                  ToolTip="{internal:LocalizedString Key=OrientedImageryViewSelectMarkerSymbol}">
            <ComboBox.ItemContainerStyle>
                <Style TargetType="{x:Type ComboBoxItem}">
                    <Setter Property="MinWidth" Value="40" />
                    <Setter Property="MinHeight" Value="40" />
                    <Setter Property="Padding" Value="4" />
                    <Setter Property="HorizontalContentAlignment" Value="Center" />
                    <Setter Property="VerticalContentAlignment" Value="Center" />
                </Style>
            </ComboBox.ItemContainerStyle>
            <ComboBox.ItemTemplate>
                <DataTemplate>
                    <controls:SymbolDisplay Symbol="{Binding}" Width="32" Height="32" Focusable="False" />
                </DataTemplate>
            </ComboBox.ItemTemplate>
        </ComboBox>
    </DataTemplate>

    <DataTemplate x:Key="ClearMarkersToolbarTemplate" DataType="controls:ClearMarkersVM">
        <Button Style="{StaticResource ToolbarLabeledButtonStyle}"
                Command="{Binding ViewModel.ClearMarkersCommand}"
                ToolTip="{internal:LocalizedString Key=OrientedImageryViewClearMarkers}">
            <StackPanel>
                <Viewbox Width="28" Height="28" Stretch="Uniform">
                    <TextBlock Text="&#xe83e;"
                               FontSize="24"
                               FontFamily="{StaticResource ToolkitIconsFontFamily}"
                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                </Viewbox>
                <TextBlock Style="{StaticResource ToolbarLabelStyle}" Text="{internal:LocalizedString Key=OrientedImageryViewClearMarkersLabel}" />
            </StackPanel>
        </Button>
    </DataTemplate>

    <DataTemplate x:Key="SequentialNavigationToolbarTemplate" DataType="controls:SequentialNavigationVM">
        <Button Command="{Binding ViewModel.ToggleSequentialNavigationCommand}"
                IsEnabled="{Binding ViewModel.SupportsSequentialNavigation}">
            <Button.Style>
                <Style TargetType="{x:Type Button}" BasedOn="{StaticResource ToolbarLabeledButtonStyle}">
                    <Setter Property="ToolTip" Value="{internal:LocalizedString Key=OrientedImageryViewEnterSequentialNavigation}" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding ViewModel.IsSequentialNavigationEnabled}" Value="True">
                            <Setter Property="ToolTip" Value="{internal:LocalizedString Key=OrientedImageryViewReturnToResults}" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Button.Style>
            <StackPanel>
                <Grid Width="28" Height="28">
                    <Path Width="28"
                          Height="28"
                          Stretch="Uniform"
                          Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                          Data="M6 4V8H2V28H25V24H29V4H6ZM24 27H3V9H24V27ZM28 23H25V8H7V5H28V23ZM16.0732 21L19.5859 17.5L16.0876 14H17.5016L21 17.5L17.4872 21H16.0732ZM6.00897 17.5L9.51568 14H10.9297L7.42303 17.5L10.9063 21H9.49225L6.00897 17.5Z">
                        <Path.Style>
                            <Style TargetType="{x:Type Path}">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ViewModel.IsSequentialNavigationEnabled}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Path.Style>
                    </Path>
                    <Path Width="28"
                          Height="28"
                          Stretch="Uniform"
                          Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                          Data="M4 18H3V29H29V3H12V4H28V28H4V18ZM5.66 13.354L1.807 9.5L5.66 5.646L6.367 6.353L3.767 9H11.5C13.7489 8.9923 15.9086 9.87918 17.503 11.4652C19.0974 13.0512 19.9958 15.2061 20 17.455V22.855H19V17.455C18.9956 13.3147 15.6403 9.95941 11.5 9.955H3.675L6.367 12.646L5.66 13.354Z">
                        <Path.Style>
                            <Style TargetType="{x:Type Path}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ViewModel.IsSequentialNavigationEnabled}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Path.Style>
                    </Path>
                </Grid>
                <TextBlock Style="{StaticResource ToolbarLabelStyle}" Text="{internal:LocalizedString Key=OrientedImageryViewNavigationModeLabel}" />
            </StackPanel>
        </Button>
    </DataTemplate>

    <DataTemplate x:Key="ToolbarDividerTemplate" DataType="controls:ToolbarDividerVM">
        <Border Width="1" Height="72" Margin="8,6" Focusable="False"
                Background="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}" />
    </DataTemplate>

    <!-- Image viewport style -->
    <Style TargetType="{x:Type controls:OrientedImageViewport}">
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:OrientedImageViewport}">
                    <Border
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}">
                        <Border x:Name="PART_DisplayHost" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Toolbar container style -->
    <Style x:Key="OrientedImageryToolbarContainerStyle" TargetType="{x:Type ItemsControl}">
        <Setter Property="Margin" Value="8" />
        <Setter Property="ItemsPanel">
            <Setter.Value>
                <ItemsPanelTemplate>
                    <WrapPanel HorizontalAlignment="Center" Orientation="Horizontal" />
                </ItemsPanelTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <controls:OrientedImageryViewTemplateSelector x:Key="DefaultOrientedImageryToolbarSelector">
        <controls:OrientedImageryViewTemplateSelectorItem Type="{x:Type controls:ToolbarDividerVM}" Template="{StaticResource ToolbarDividerTemplate}" />
        <controls:OrientedImageryViewTemplateSelectorItem Type="{x:Type controls:SelectNewMarkerSymbolVM}" Template="{StaticResource MarkerPickerToolbarTemplate}" />
        <controls:OrientedImageryViewTemplateSelectorItem Type="{x:Type controls:AllowAddingMarkersVM}" Template="{StaticResource AllowAddingMarkersToolbarTemplate}" />
        <controls:OrientedImageryViewTemplateSelectorItem Type="{x:Type controls:ImageSearchModeVM}" Template="{StaticResource ImageSearchModeToolbarTemplate}" />
        <controls:OrientedImageryViewTemplateSelectorItem Type="{x:Type controls:ShowSelectedFootprintVM}" Template="{StaticResource ShowSelectedFootprintToolbarTemplate}" />
        <controls:OrientedImageryViewTemplateSelectorItem Type="{x:Type controls:ShowUnselectedFootprintsVM}" Template="{StaticResource ShowUnselectedFootprintsToolbarTemplate}" />
        <controls:OrientedImageryViewTemplateSelectorItem Type="{x:Type controls:ShowCameraMarkersVM}" Template="{StaticResource ShowCameraMarkersToolbarTemplate}" />
        <controls:OrientedImageryViewTemplateSelectorItem Type="{x:Type controls:ClearMarkersVM}" Template="{StaticResource ClearMarkersToolbarTemplate}" />
        <controls:OrientedImageryViewTemplateSelectorItem Type="{x:Type controls:ShowSelectedImagePopupVM}" Template="{StaticResource ShowSelectedImagePopupToolbarTemplate}" />
        <controls:OrientedImageryViewTemplateSelectorItem Type="{x:Type controls:SequentialNavigationVM}" Template="{StaticResource SequentialNavigationToolbarTemplate}" />
    </controls:OrientedImageryViewTemplateSelector>

    <!-- Main view style -->
    <Style TargetType="{x:Type controls:OrientedImageryView}">
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.WindowBrushKey}}" />
        <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}" />
        <Setter Property="DisplayBackgroundColor">
            <Setter.Value>
                <Binding Path="Background.Color" RelativeSource="{RelativeSource Self}" Converter="{StaticResource ColorToColorConverter}" />
            </Setter.Value>
        </Setter>

        <Setter Property="ToolbarItemTemplateSelector" Value="{StaticResource DefaultOrientedImageryToolbarSelector}" />

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:OrientedImageryView}">
                    <Border
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Border BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}"
                                    BorderThickness="0,0,0,1">
                                <ComboBox Margin="8"
                                          MinHeight="40"
                                          HorizontalContentAlignment="Stretch"
                                          ItemsSource="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=OrientedImageryLayers}"
                                          SelectedItem="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=SelectedLayer, Mode=TwoWay}"
                                          DisplayMemberPath="Name"
                                          AutomationProperties.Name="{internal:LocalizedString Key=OrientedImageryViewLayerSelection}" />
                            </Border>

                            <ItemsControl x:Name="PART_ToolbarContainer" Grid.Row="1" IsTabStop="False" Focusable="False"
                                          Style="{StaticResource OrientedImageryToolbarContainerStyle}"
                                          ItemTemplateSelector="{StaticResource DefaultOrientedImageryToolbarSelector}" />

                            <Grid Grid.Row="2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <controls:OrientedImageViewport Grid.ColumnSpan="3"
                                                               x:Name="PART_ImageViewport"
                                                               DisplayBackgroundColor="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=DisplayBackgroundColor}" />

                                <Border Grid.ColumnSpan="3"
                                        Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}">
                                    <Border.Style>
                                        <Style TargetType="{x:Type Border}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ElementName=PART_ImageViewport, Path=IsInteractive}" Value="False">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=ViewModel.SelectedImage}" Value="{x:Null}">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               Text="{internal:LocalizedString Key=OrientedImageryViewLoading}" />
                                </Border>

                                <ProgressBar Grid.ColumnSpan="3"
                                             Height="2"
                                             VerticalAlignment="Top"
                                             IsIndeterminate="True">
                                    <ProgressBar.Style>
                                        <Style TargetType="{x:Type ProgressBar}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ElementName=PART_ImageViewport, Path=IsBusy}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=ViewModel.SelectedImage}" Value="{x:Null}">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ProgressBar.Style>
                                </ProgressBar>

                                <Border Grid.ColumnSpan="3"
                                        Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}">
                                    <Border.Style>
                                        <Style TargetType="{x:Type Border}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=ViewModel.SelectedImage}" Value="{x:Null}">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               Text="{internal:LocalizedString Key=OrientedImageryViewNoImagesSelected}" />
                                </Border>

                                <Popup PlacementTarget="{Binding ElementName=PART_ImageViewport}"
                                       Placement="Center"
                                       StaysOpen="True">
                                    <Popup.Style>
                                        <Style TargetType="{x:Type Popup}">
                                            <Setter Property="IsOpen" Value="True" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ElementName=PART_ImageViewport, Path=Error}" Value="{x:Null}">
                                                    <Setter Property="IsOpen" Value="False" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Popup.Style>
                                    <Border Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}"
                                            TextElement.Foreground="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}"
                                            BorderBrush="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}"
                                            BorderThickness="1"
                                            Padding="8">
                                        <TextBlock MaxWidth="300"
                                                   Text="{Binding ElementName=PART_ImageViewport, Path=Error.Message}"
                                                   TextWrapping="Wrap" />
                                    </Border>
                                </Popup>

                                <Button Style="{StaticResource ImageNavigationButtonStyle}"
                                        Command="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=ViewModel.SelectPreviousImageCommand}"
                                        ToolTip="{internal:LocalizedString Key=OrientedImageryViewPreviousImage}"
                                        VerticalAlignment="Center">
                                    <Viewbox Width="20" Height="20" Stretch="Uniform">
                                        <Grid Width="32" Height="32">
                                            <Path SnapsToDevicePixels="true" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Data="M20 26.1 9.9 16 20 5.9z">
                                                <Path.RenderTransform>
                                                    <TranslateTransform X="-3" Y="3" />
                                                </Path.RenderTransform>
                                            </Path>
                                        </Grid>
                                    </Viewbox>
                                </Button>
                                <Button Style="{StaticResource ImageNavigationButtonStyle}"
                                        Command="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=ViewModel.SelectNextImageCommand}"
                                        ToolTip="{internal:LocalizedString Key=OrientedImageryViewNextImage}"
                                        Grid.Column="2" VerticalAlignment="Center">
                                    <Viewbox Width="20" Height="20" Stretch="Uniform">
                                        <Grid Width="32" Height="32">
                                            <Path SnapsToDevicePixels="true" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Data="M12 5.9 22.1 16 12 26.1z">
                                                <Path.RenderTransform>
                                                    <TranslateTransform Y="2" />
                                                </Path.RenderTransform>
                                            </Path>
                                        </Grid>
                                    </Viewbox>
                                </Button>
                            </Grid>

                            <Grid Grid.Row="1"
                                  Grid.RowSpan="2"
                                  Panel.ZIndex="2"
                                  Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <Grid.Style>
                                    <Style TargetType="{x:Type Grid}">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=ViewModel.SelectedImagePopup}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Grid.Style>
                                <controls:PopupViewer Grid.Row="1"
                                                      Margin="8,0,8,8"
                                                      Popup="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=ViewModel.SelectedImagePopup}" />
                                <Button HorizontalAlignment="Right"
                                        VerticalAlignment="Center"
                                        Margin="8,8,8,0"
                                        MinWidth="32"
                                        MinHeight="32"
                                        Command="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=ViewModel.CloseSelectedImagePopupCommand}"
                                        Content="&#xeb49;"
                                        FontFamily="{StaticResource ToolkitIconsFontFamily}"
                                        FontSize="20"
                                        Style="{StaticResource ToolbarButtonStyle}"
                                        ToolTip="{internal:LocalizedString Key=OrientedImageryViewCloseSelectedImagePopup}" />
                            </Grid>

                            <Border Grid.Row="1"
                                    Grid.RowSpan="2"
                                    Padding="16"
                                    Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}"
                                    TextElement.Foreground="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}">
                                <Border.Style>
                                    <Style TargetType="{x:Type Border}">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=ErrorMessage}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           MaxWidth="400"
                                           Text="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=ErrorMessage}"
                                           TextAlignment="Center"
                                           TextWrapping="Wrap" />
                            </Border>

                            <local:Paginator x:Name="PART_Paginator" HorizontalAlignment="Center" Grid.Row="3">
                                <local:Paginator.Style>
                                    <Style TargetType="{x:Type local:Paginator}">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=ViewModel.IsSequentialNavigationEnabled}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=ViewModel.SelectedImage}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </local:Paginator.Style>
                            </local:Paginator>
                            <StackPanel Grid.Row="3"
                                        Orientation="Horizontal"
                                        HorizontalAlignment="Center">
                                <StackPanel.Style>
                                    <Style TargetType="{x:Type StackPanel}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=ViewModel.IsSequentialNavigationEnabled}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=ViewModel.SelectedImage}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <Button Style="{StaticResource PaginatorNavigationButtonStyle}"
                                        IsTabStop="False"
                                        Command="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=ViewModel.SelectPreviousImageCommand}"
                                        ToolTip="{internal:LocalizedString Key=OrientedImageryViewPreviousImage}">
                                    <TextBlock Text="&lt;" />
                                </Button>
                                <Button Content="{internal:LocalizedString Key=OrientedImageryViewPreviousLabel}"
                                        Style="{StaticResource PaginatorPageButtonStyle}"
                                        Command="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=ViewModel.SelectPreviousImageCommand}"
                                        ToolTip="{internal:LocalizedString Key=OrientedImageryViewPreviousImage}"
                                        AutomationProperties.Name="{internal:LocalizedString Key=OrientedImageryViewPreviousImage}" />
                                <Grid Width="35" Height="32">
                                    <TextBlock Text="."
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}"
                                               FontSize="14" />
                                    <Border Height="2"
                                            Margin="1,0"
                                            VerticalAlignment="Bottom"
                                            Background="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}" />
                                </Grid>
                                <Button Content="{internal:LocalizedString Key=OrientedImageryViewNextLabel}"
                                        Style="{StaticResource PaginatorPageButtonStyle}"
                                        Command="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=ViewModel.SelectNextImageCommand}"
                                        ToolTip="{internal:LocalizedString Key=OrientedImageryViewNextImage}"
                                        AutomationProperties.Name="{internal:LocalizedString Key=OrientedImageryViewNextImage}" />
                                <Button Style="{StaticResource PaginatorNavigationButtonStyle}"
                                        IsTabStop="False"
                                        Command="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=ViewModel.SelectNextImageCommand}"
                                        ToolTip="{internal:LocalizedString Key=OrientedImageryViewNextImage}">
                                    <TextBlock Text="&gt;" />
                                </Button>
                            </StackPanel>
                            <TextBlock Grid.Row="4"
                                       Text="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=ViewModel.SequentialNavigationError.Message}"
                                       Foreground="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}"
                                       TextWrapping="Wrap"
                                       TextAlignment="Center"
                                       Margin="8,0,8,4">
                                <TextBlock.Style>
                                    <Style TargetType="{x:Type TextBlock}">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=ViewModel.SequentialNavigationError}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
