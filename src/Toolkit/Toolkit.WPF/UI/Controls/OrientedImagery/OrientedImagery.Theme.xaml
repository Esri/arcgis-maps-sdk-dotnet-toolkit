            <ComboBox Grid.Column="1" TabIndex="1" MinWidth="0" Padding="0"
                      ItemsSource="{Binding ImageSearchModes}"
                      SelectedItem="{Binding SelectedInteractionState, Mode=TwoWay}"
                      Style="{StaticResource ImageSearchModeComboBoxStyle}"
                      AutomationProperties.Name="{internal:LocalizedString Key=OrientedImageryViewImageSearchMode}"
                      ToolTip="{internal:LocalizedString Key=OrientedImageryViewImageSearchMode}">
                <ComboBox.ItemContainerStyle>
                    <Style TargetType="{x:Type ComboBoxItem}" BasedOn="{StaticResource ToolbarComboBoxItemStyle}">
                        <Setter Property="controls:ImageSearchModeSelectionBehavior.RepeatSelection" Value="True" />
                        <Setter Property="MinHeight" Value="40" />
                        <Setter Property="Padding" Value="8,4" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="VerticalContentAlignment" Value="Center" />
                    </Style>
                </ComboBox.ItemContainerStyle>
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <Viewbox Width="24" Height="24" Margin="0,0,8,0" Stretch="Uniform">
                                <ContentControl Content="{Binding}"
                                                ContentTemplate="{StaticResource ImageSearchModeIconTemplate}"
                                                Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ComboBoxItem}}"
                                                Focusable="False" IsTabStop="False" />
                            </Viewbox>
                            <TextBlock VerticalAlignment="Center"
                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ComboBoxItem}}">
                                <TextBlock.Style>
                                    <Style TargetType="{x:Type TextBlock}">
                                        <Setter Property="Text" Value="{internal:LocalizedString Key=OrientedImageryViewImageSearchModeDisplay}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding}" Value="{x:Static controls:OrientedImageryViewInteractionState.FindImages}">
                                                <Setter Property="Text" Value="{internal:LocalizedString Key=OrientedImageryViewImageSearchModeFind}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
        </Grid>
    </DataTemplate>

    <DataTemplate x:Key="MarkerPickerToolbarTemplate" DataType="controls:SelectNewMarkerSymbolVM">
        <ComboBox ItemsSource="{Binding SymbolOptions}"
                  SelectedItem="{Binding SelectedSymbol, Mode=TwoWay}"
                  MinWidth="0" Padding="0"
                  Style="{StaticResource ToolbarComboBoxStyle}"
                  AutomationProperties.Name="{internal:LocalizedString Key=OrientedImageryViewSelectMarkerSymbol}"
                  ToolTip="{internal:LocalizedString Key=OrientedImageryViewSelectMarkerSymbol}">
            <ComboBox.Template>
                <ControlTemplate TargetType="{x:Type ComboBox}">
                    <Grid>
                        <ToggleButton x:Name="MarkerSymbolDropdownButton"
                                      AutomationProperties.Name="{TemplateBinding AutomationProperties.Name}"
                                      MinWidth="0" MinHeight="84" Padding="0"
                                      ClickMode="Press" Focusable="False"
                                      IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                      Foreground="{TemplateBinding Foreground}"
                                      Style="{StaticResource ToolbarToggleButtonStyle}"
                                      ToolTip="{TemplateBinding ToolTip}">
                            <StackPanel>
                                <controls:SymbolDisplay Symbol="{Binding SelectedItem, RelativeSource={RelativeSource TemplatedParent}}"
                                                        Width="16" Height="32" Focusable="False" />
                                <Grid Height="32" Margin="0,8,0,0">
                                    <Path Width="12" Height="8" VerticalAlignment="Center"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"
                                          StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                          StrokeLineJoin="Round" Data="M1 1L6 6L11 1" />
                                </Grid>
                            </StackPanel>
                        </ToggleButton>
                        <Popup x:Name="PART_Popup"
                               AllowsTransparency="True"
                               Focusable="False"
                               IsOpen="{TemplateBinding IsDropDownOpen}"
                               Placement="Bottom"
                               PopupAnimation="Slide">
                            <Border MinWidth="{TemplateBinding ActualWidth}"
                                    MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                    Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}"
                                    BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}"
                                    BorderThickness="1">
                                <ScrollViewer SnapsToDevicePixels="True">
                                    <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained" />
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                </ControlTemplate>
            </ComboBox.Template>
            <ComboBox.ItemContainerStyle>
                <Style TargetType="{x:Type ComboBoxItem}" BasedOn="{StaticResource ToolbarComboBoxItemStyle}">
                    <Setter Property="MinWidth" Value="40" />
                    <Setter Property="MinHeight" Value="40" />
                    <Setter Property="Padding" Value="4" />
                    <Setter Property="HorizontalContentAlignment" Value="Center" />
                    <Setter Property="VerticalContentAlignment" Value="Center" />
                </Style>
            </ComboBox.ItemContainerStyle>
            <ComboBox.ItemTemplate>
                <DataTemplate>
                    <controls:SymbolDisplay Symbol="{Binding}" Width="32" Height="32" Focusable="False" />
                </DataTemplate>
            </ComboBox.ItemTemplate>
        </ComboBox>
    </DataTemplate>

