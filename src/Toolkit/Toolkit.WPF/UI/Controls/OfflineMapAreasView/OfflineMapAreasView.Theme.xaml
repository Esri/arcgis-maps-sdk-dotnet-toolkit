    </Style>

    <Style x:Key="OfflineMapAreasViewStatePanelStyle" TargetType="{x:Type StackPanel}">
        <Setter Property="Visibility" Value="Collapsed" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="MaxWidth" Value="320" />
    </Style>

    <Style TargetType="{x:Type controls:OfflineMapAreasView}">
        <!--  Default item template can be overriden by the user.  -->
        <Setter Property="ItemTemplate">
            <Setter.Value>
                <DataTemplate>
                    <Grid
                        Height="64"
                        Margin="0,4"
                        AutomationProperties.HelpText="{Binding Title}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="68" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Border
                            Grid.RowSpan="3"
                            Margin="0,0,4,0"
                            BorderBrush="LightGray"
                            BorderThickness="1"
                            CornerRadius="8">
                            <Image
                                Width="64"
                                Height="64"
                                Source="{Binding ThumbnailData}"
                                Stretch="UniformToFill" />
                        </Border>

                        <TextBlock
                            Grid.Column="1"
                            FontSize="14"
                            FontWeight="SemiBold"
                            Text="{Binding Title}"
                            TextTrimming="CharacterEllipsis" />

                        <TextBlock
                            Grid.Row="1"
                            Grid.Column="1"
                            MaxHeight="42"
                            Margin="0,2,0,0"
                            Foreground="#FF666666"
                            Text="{Binding Description}"
                            TextWrapping="Wrap" />

                        <TextBlock
                            Grid.Row="2" Grid.Column="1"
                            Foreground="#FF666666"
                            Text="Downloaded" Visibility="{Binding IsDownloaded, Converter={StaticResource OfflineMapAreasViewVisibilityConverter}, Mode=OneWay}">
                        </TextBlock>

                        <Grid Grid.RowSpan="3" Grid.Column="2">
                            <Button
                                  AutomationProperties.HelpText="Stop"
                                  Command="{Binding StopDownloadCommand}" Style="{StaticResource OfflineMapAreasViewIconButtonStyle}" 
                                  ToolTipService.ToolTip="Stop" Visibility="{Binding IsDownloading, Converter={StaticResource OfflineMapAreasViewVisibilityConverter}, Mode=OneWay}">
                                <TextBlock FontFamily="{StaticResource ToolkitIconsFontFamily}" FontSize="14" Text="&#xE7B3;" />
                            </Button>

                            <Button
                                 AutomationProperties.HelpText="Download"
                                 Command="{Binding DownloadCommand}"
                                 ToolTipService.ToolTip="Download"
                                 Style="{StaticResource OfflineMapAreasViewIconButtonStyle}" 
                                 Visibility="{Binding AllowsDownload, Converter={StaticResource OfflineMapAreasViewVisibilityConverter}, Mode=OneWay}">
                                <TextBlock FontFamily="{StaticResource ToolkitIconsFontFamily}" FontSize="16" Text="&#xE81C;" />
                            </Button>

                            <StackPanel Orientation="Horizontal" Visibility="{Binding IsDownloaded, Converter={StaticResource OfflineMapAreasViewVisibilityConverter}, Mode=OneWay}">
                                <Button
                                    AutomationProperties.HelpText="Remove"
                                    Command="{Binding RemoveDownloadCommand}"
                                    Style="{StaticResource OfflineMapAreasViewIconButtonStyle}"
                                    ToolTipService.ToolTip="Remove">
                                    <TextBlock FontFamily="{StaticResource ToolkitIconsFontFamily}" FontSize="14" Text="&#xEB04;" />
                                </Button>
                                <Button
                                    Margin="8,0,0,0" VerticalAlignment="Center"
                                    AutomationProperties.HelpText="Open"
                                    Command="{Binding OpenCommand}"
                                    CommandParameter="{Binding Map}"
                                    Content="Open" />
                                <Button Margin="8,0,0,0" VerticalAlignment="Center"
                                    AutomationProperties.HelpText="{Binding Error.Message, Mode=OneWay}"
                                    ToolTipService.ToolTip="{Binding Error.Message, Mode=OneWay}"
                                    Command="{Binding RemoveDownloadCommand, Mode=OneWay}" Visibility="{Binding Error, Converter={StaticResource OfflineMapAreasViewVisibilityConverter}, Mode=OneWay}">
                                    <TextBlock FontFamily="{StaticResource ToolkitIconsFontFamily}" FontSize="16" Text="&#xE844;" />
                                </Button>
                            </StackPanel>
                        </Grid>
                        <ProgressBar
                             Grid.Column="1" Grid.ColumnSpan="2" Grid.Row="2"
                             Minimum="0" Maximum="1" VerticalAlignment="Bottom"
                             IsIndeterminate="False" IsHitTestVisible="False"
                             Value="{Binding DownloadProgress, Mode=OneWay}" Visibility="{Binding IsDownloading, Converter={StaticResource OfflineMapAreasViewVisibilityConverter}, Mode=OneWay}"/>

                    </Grid>
                </DataTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:OfflineMapAreasView}">
                    <Border
                        Width="{TemplateBinding Width}"
                        Height="{TemplateBinding Height}"
                        Padding="{TemplateBinding Padding}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}">
                        <Grid>
                            <ScrollViewer VerticalScrollBarVisibility="{TemplateBinding VerticalScrollBarVisibility}" Visibility="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=TemplateSettings.IsAddOnDemandMode,Converter={StaticResource OfflineMapAreasViewVisibilityConverter}, ConverterParameter=Reverse}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <ItemsControl
                                    x:Name="MapAreasView"
                                    Grid.Row="0"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Stretch"
                                    ItemsSource="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=TemplateSettings.MapAreas}"
                                    ItemTemplate="{TemplateBinding ItemTemplate}"/>

                                <StackPanel Grid.Row="0">
                                    <StackPanel.Style>
                                        <Style BasedOn="{StaticResource OfflineMapAreasViewStatePanelStyle}" TargetType="{x:Type StackPanel}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=TemplateSettings.MapIsOfflineDisabled}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>
                                    <TextBlock
                                        HorizontalAlignment="Center"
                                        FontFamily="{StaticResource ToolkitIconsFontFamily}"
                                        FontSize="48"
                                        Foreground="#FF8A8A8A"
                                        Text="&#xE846;" />
                                    <TextBlock
                                        Margin="0,8,0,0"
                                        HorizontalAlignment="Center"
                                        FontSize="20"
                                        FontWeight="SemiBold"
                                        Text="Offline Disabled"
                                        TextAlignment="Center" />
                                    <TextBlock
                                        Margin="0,4,0,0"
                                        HorizontalAlignment="Center"
                                        Foreground="#FF666666"
                                        Text="The map is not enabled for offline use"
                                        TextAlignment="Center"
                                        TextWrapping="Wrap" />
                                </StackPanel>

                                <StackPanel Grid.Row="0">
                                    <StackPanel.Style>
                                        <Style BasedOn="{StaticResource OfflineMapAreasViewStatePanelStyle}" TargetType="{x:Type StackPanel}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=TemplateSettings.IsInternetNotAvailable}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>
                                    <TextBlock
                                        HorizontalAlignment="Center"
                                        FontFamily="{StaticResource ToolkitIconsFontFamily}"
                                        FontSize="48"
                                        Foreground="#FF8A8A8A"
                                        Text="&#xE846;" />
                                    <TextBlock
                                        Margin="0,8,0,0"
                                        HorizontalAlignment="Center"
                                        FontSize="20"
                                        FontWeight="SemiBold"
                                        Text="No Internet Connection"
                                        TextAlignment="Center" />
                                    <TextBlock
                                        Margin="0,4,0,0"
                                        HorizontalAlignment="Center"
                                        Foreground="#FF666666"
                                        Text="Could not retrieve map areas for this map"
                                        TextAlignment="Center"
                                        TextWrapping="Wrap" />
                                    <Button
                                        x:Name="NoInternetRefreshButton"
                                        Margin="0,12,0,0"
                                        HorizontalAlignment="Center"
                                        AutomationProperties.HelpText="Refresh">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock
                                                Margin="0,0,4,0"
                                                VerticalAlignment="Center"
                                                FontFamily="{StaticResource ToolkitIconsFontFamily}"
                                                FontSize="14"
                                                Text="&#xE72C;" />
                                            <TextBlock Text="Refresh" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>

                                <StackPanel Grid.Row="0">
                                    <StackPanel.Style>
                                        <Style BasedOn="{StaticResource OfflineMapAreasViewStatePanelStyle}" TargetType="{x:Type StackPanel}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=TemplateSettings.HasNoAreas}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>
                                    <TextBlock
                                        HorizontalAlignment="Center"
                                        FontFamily="{StaticResource ToolkitIconsFontFamily}"
                                        FontSize="48"
                                        Foreground="#FF8A8A8A"
                                        Text="&#xE81C;" />
                                    <TextBlock
                                        Margin="0,8,0,0"
                                        HorizontalAlignment="Center"
                                        FontSize="20"
                                        FontWeight="SemiBold"
                                        Text="No Map Areas"
                                        TextAlignment="Center" />
                                    <TextBlock
                                        Margin="0,4,0,0"
                                        HorizontalAlignment="Center"
                                        Foreground="#FF666666"
                                        Text="There are no map areas for this map.">
                                        <TextBlock.Style>
                                            <Style TargetType="{x:Type TextBlock}">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Setter Property="TextAlignment" Value="Center" />
                                                <Setter Property="TextWrapping" Value="Wrap" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=TemplateSettings.IsPreplannedMode}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBlock
                                        Margin="0,4,0,0"
                                        HorizontalAlignment="Center"
                                        Foreground="#FF666666"
                                        Text="There are no map areas for this map. Tap the button below to get started.">
                                        <TextBlock.Style>
                                            <Style TargetType="{x:Type TextBlock}">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Setter Property="TextAlignment" Value="Center" />
                                                <Setter Property="TextWrapping" Value="Wrap" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=TemplateSettings.IsOnDemandMode}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <Button
                                        x:Name="RefreshMapAreasButton"
                                        Margin="0,12,0,0"
                                        HorizontalAlignment="Center"
                                        AutomationProperties.HelpText="Refresh">
                                        <Button.Style>
                                            <Style TargetType="{x:Type Button}">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=TemplateSettings.IsPreplannedMode}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock
                                                Margin="0,0,4,0"
                                                VerticalAlignment="Center"
                                                FontFamily="{StaticResource ToolkitIconsFontFamily}"
                                                FontSize="14"
                                                Text="&#xE72C;" />
                                            <TextBlock Text="Refresh" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>

                                <ProgressBar
                                    Grid.Row="0"
                                    Width="120"
                                    Height="4"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    IsIndeterminate="True">
                                    <ProgressBar.Style>
                                        <Style TargetType="{x:Type ProgressBar}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=TemplateSettings.IsLoadingModels}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ProgressBar.Style>
                                </ProgressBar>

                                <Button
                                    x:Name="AddMapAreaButton"
                                    Grid.Row="1"
                                    Margin="0,12,0,0"
                                    HorizontalAlignment="Center"
                                    AutomationProperties.HelpText="Add Map Area">
                                    <Button.Style>
                                        <Style TargetType="{x:Type Button}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=TemplateSettings.IsOnDemandMode}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock
                                            Margin="0,0,4,0"
                                            VerticalAlignment="Center"
                                            FontFamily="{StaticResource ToolkitIconsFontFamily}"
                                            FontSize="18"
                                            Text="&#xE9F6;" />
                                        <TextBlock VerticalAlignment="Center" Text="Add Map Area" />
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </ScrollViewer>
                        <!-- Add Map Area View -->
                        <Grid Visibility="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=TemplateSettings.IsAddOnDemandMode,Converter={StaticResource OfflineMapAreasViewVisibilityConverter}}" Margin="16">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition MaxHeight="400" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="Select Area" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" />
                            <Grid Grid.Row="1" Margin="0,8">
                                <esri:MapView xmlns:esri="http://schemas.esri.com/arcgis/runtime/2013" ViewInsets="40"
                                    x:Name="AddAreaMapView" Grid.Row="1" IsAttributionTextVisible="False" BorderBrush="Black" BorderThickness="1" />
                                <Border BorderBrush="Black" BorderThickness="40" IsHitTestVisible="False" Opacity=".5" />
                            </Grid>
                            <TextBox Grid.Row="2" x:Name="AddOnDemandAreaNameTextBox" />
                            <Button Content="Add" Grid.Row="3" HorizontalAlignment="Stretch" x:Name="AcceptAddOnDemandAreaButton" Margin="0,8,0,0" />
                            <Button Content="Cancel" HorizontalAlignment="Right" x:Name="CancelAddOnDemandAreaButton" />

                        </Grid>
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="VerticalAlignment" Value="Stretch" />
    </Style>
</ResourceDictionary>
