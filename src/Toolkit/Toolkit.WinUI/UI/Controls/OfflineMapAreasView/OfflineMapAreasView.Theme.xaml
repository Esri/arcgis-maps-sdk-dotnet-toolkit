<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:Class="Esri.ArcGISRuntime.Toolkit.OfflineMapAreasViewResources"
    xmlns:controls="using:Esri.ArcGISRuntime.Toolkit.UI.Controls"
    xmlns:local="using:Esri.ArcGISRuntime.Toolkit.UI.Controls">
    <Style TargetType="controls:OfflineMapAreasView">
        <!--  Default item template can be overriden by the user.  -->
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="controls:OfflineMapAreasView">
                    <Border
                        Width="{TemplateBinding Width}"
                        Height="{TemplateBinding Height}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
                        <ScrollViewer VerticalScrollBarVisibility="{TemplateBinding VerticalScrollBarVisibility}">
                            <StackPanel>
                                <ProgressRing IsIndeterminate="{Binding TemplateSettings.IsLoadingModels, RelativeSource={RelativeSource Mode=TemplatedParent}}" />
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding OnlineMap.Item.Title, RelativeSource={RelativeSource Mode=TemplatedParent}}" />
                                    <TextBlock Text="(Online)" />
                                </StackPanel>
                                <TextBlock Text="On-Demand Map Areas" />
                                <ItemsControl x:Name="ListView" 
                                          ItemsSource="{Binding RelativeSource={RelativeSource Mode=TemplatedParent}, Path=TemplateSettings.OnDemandMapModels}" >
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="controls:IOfflineMapAreaItem">
                                            <StackPanel>
                                                <TextBlock Text="{x:Bind Title, Mode=OneWay}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Text="Preplanned Map Areas" />
                                <ItemsControl x:Name="ListView2" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                        ItemsSource="{Binding RelativeSource={RelativeSource Mode=TemplatedParent}, Path=TemplateSettings.PreplannedMapModels}" >
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="controls:IOfflineMapAreaItem">
                                            <Grid Height="64" Margin="0,4">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>
                                                <Image Source="{Binding ThumbnailData}" Width="64" Height="64" Stretch="UniformToFill" Grid.RowSpan="2" />
                                                <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                                    <TextBlock Text="{x:Bind Title, Mode=OneWay}" TextTrimming="CharacterEllipsis" FontWeight="Bold" />
                                                    <TextBlock Text="{x:Bind Description, Mode=OneWay}" TextWrapping="Wrap" />
                                                </StackPanel>
                                                <TextBlock Text="Downloaded" Grid.Row="1" Grid.Column="1" Margin="8,0,0,0" /> <!-- TODO: SHow if IsDownloaded==true-->
                                                <Grid Grid.Column="2" Grid.RowSpan="2">

                                                    <AppBarButton Icon="Download" Command="{x:Bind DownloadCommand, Mode=OneTime}" Visibility="{x:Bind AllowsDownload, Mode=OneWay}"/>
                                                    <!--<ProgressRing IsHitTestVisible="False" Value=".5" Visibility="{x:Bind IsDownloaded}" />-->

                                                </Grid>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="VerticalAlignment" Value="Stretch" />
    </Style>
</ResourceDictionary>
