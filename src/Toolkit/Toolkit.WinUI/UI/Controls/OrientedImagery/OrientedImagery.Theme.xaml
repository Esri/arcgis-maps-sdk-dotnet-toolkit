<ResourceDictionary
    x:Class="Esri.ArcGISRuntime.Toolkit.OrientedImageryResources"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Esri.ArcGISRuntime.Toolkit.UI.Controls"
    xmlns:internal="using:Esri.ArcGISRuntime.Toolkit.Internal"
    xmlns:local="using:Esri.ArcGISRuntime.Toolkit">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="../../../Themes/SharedResources.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <Style x:Key="OrientedImageryToolbarButtonStyle" TargetType="Button">
        <Setter Property="MinWidth" Value="40" />
        <Setter Property="MinHeight" Value="40" />
        <Setter Property="Padding" Value="4" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
    </Style>

    <Style x:Key="OrientedImageryToolbarToggleButtonStyle" TargetType="ToggleButton">
        <Setter Property="MinWidth" Value="40" />
        <Setter Property="MinHeight" Value="40" />
        <Setter Property="Padding" Value="4" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
    </Style>

    <Style x:Key="OrientedImageryNavigationButtonStyle" TargetType="Button">
        <Setter Property="Width" Value="32" />
        <Setter Property="MinHeight" Value="60" />
        <Setter Property="Padding" Value="4" />
        <Setter Property="Background" Value="#80FFFFFF" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>

    <Style TargetType="controls:OrientedImageDisplay">
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="controls:OrientedImageDisplay">
                    <Border
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}">
                        <ContentPresenter x:Name="PART_DisplayHost" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="controls:OrientedImageryView">
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="controls:OrientedImageryView">
                    <Border
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">

                                <ToggleButton
                                    IsChecked="{x:Bind ViewModel.ShowSelectedFootprint, Mode=TwoWay}"
                                    Style="{StaticResource OrientedImageryToolbarToggleButtonStyle}"
                                    ToolTipService.ToolTip="{internal:LocalizedString Key=OrientedImageryViewShowSelectedFootprint}">
                                    <Viewbox Width="30" Height="30" Stretch="Uniform">
                                        <Grid Width="24" Height="24">
                                            <Path Data="F0 M19.384 20H4.616L.349 4h23.302z">
                                                <Path.Fill>
                                                    <SolidColorBrush Color="{x:Bind local:OrientedImageryResources.ToWindowsColor(ViewModel.SelectedFootprintFillColor), Mode=OneWay}" />
                                                </Path.Fill>
                                                <Path.Stroke>
                                                    <SolidColorBrush Color="{x:Bind local:OrientedImageryResources.ToWindowsColor(ViewModel.SelectedFootprintOutlineColor), Mode=OneWay}" />
                                                </Path.Stroke>
                                            </Path>
                                        </Grid>
                                    </Viewbox>
                                </ToggleButton>

                                <ToggleButton
                                    IsChecked="{x:Bind ViewModel.ShowUnselectedFootprints, Mode=TwoWay}"
                                    Style="{StaticResource OrientedImageryToolbarToggleButtonStyle}"
                                    ToolTipService.ToolTip="{internal:LocalizedString Key=OrientedImageryViewShowUnselectedFootprints}">
                                    <Viewbox Width="30" Height="30" Stretch="Uniform">
                                        <Grid Width="24" Height="24">
                                            <Path Data="F0 M19.384 20H4.616L.349 4h23.302z">
                                                <Path.Fill>
                                                    <SolidColorBrush Color="{x:Bind local:OrientedImageryResources.ToWindowsColor(ViewModel.UnselectedFootprintFillColor), Mode=OneWay}" />
                                                </Path.Fill>
                                                <Path.Stroke>
                                                    <SolidColorBrush Color="{x:Bind local:OrientedImageryResources.ToWindowsColor(ViewModel.UnselectedFootprintOutlineColor), Mode=OneWay}" />
                                                </Path.Stroke>
                                            </Path>
                                        </Grid>
                                    </Viewbox>
                                </ToggleButton>

                                <Button
                                    Command="{x:Bind CameraMarkers.ToggleCameraMarkerDisplayMode, Mode=OneWay}"
                                    Style="{StaticResource OrientedImageryToolbarButtonStyle}"
                                    ToolTipService.ToolTip="{internal:LocalizedString Key=OrientedImageryViewToggleCameraMarkers}">
                                    <Grid Width="32" Height="32" UseLayoutRounding="True">
                                        <Viewbox Width="32" Height="32">
                                            <FontIcon
                                                Glyph="&#xe77a;"
                                                FontSize="32"
                                                FontFamily="{StaticResource toolkit-icons}"
                                                Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                                Visibility="{x:Bind local:OrientedImageryResources.VisibleWhenFalse(ViewModel.ShowCameraLocationsOnDisplay), Mode=OneWay}" />
                                        </Viewbox>
                                        <Viewbox Width="32" Height="32">
                                            <FontIcon
                                                Glyph="&#xe77d;"
                                                FontSize="24"
                                                FontFamily="{StaticResource toolkit-icons}"
                                                Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                                Visibility="{x:Bind local:OrientedImageryResources.VisibleWhen(ViewModel.ShowCameraLocationsOnDisplay), Mode=OneWay}" />
                                        </Viewbox>
                                    </Grid>
                                </Button>

                                <ToggleButton
                                    IsChecked="{x:Bind ViewModel.AllowAddingMarkers, Mode=TwoWay}"
                                    Style="{StaticResource OrientedImageryToolbarToggleButtonStyle}"
                                    ToolTipService.ToolTip="{internal:LocalizedString Key=OrientedImageryViewToggleAddMarkers}">
                                    <Viewbox Width="32" Height="32" Stretch="Uniform">
                                        <FontIcon
                                            Glyph="&#xe8ed;"
                                            FontSize="24"
                                            FontFamily="{StaticResource toolkit-icons}"
                                            Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                    </Viewbox>
                                </ToggleButton>

                                <Button
                                    Command="{x:Bind MarkerSymbolPicker.SelectNextSymbol, Mode=OneWay}"
                                    Style="{StaticResource OrientedImageryToolbarButtonStyle}"
                                    ToolTipService.ToolTip="{internal:LocalizedString Key=OrientedImageryViewSelectMarkerSymbol}"
                                    Visibility="{x:Bind local:OrientedImageryResources.VisibleWhen(ViewModel.AllowAddingMarkers), Mode=OneWay}">
                                    <controls:SymbolDisplay Width="32" Height="32" Symbol="{x:Bind MarkerSymbolPicker.SelectedSymbol, Mode=OneWay}" />
                                </Button>

                                <Button
                                    Command="{x:Bind ViewModel.ClearMarkersCommand, Mode=OneWay}"
                                    Style="{StaticResource OrientedImageryToolbarButtonStyle}"
                                    ToolTipService.ToolTip="{internal:LocalizedString Key=OrientedImageryViewClearMarkers}">
                                    <Viewbox Width="32" Height="32" Stretch="Uniform">
                                        <FontIcon
                                                Glyph="&#xe83e;"
                                                FontSize="24"
                                                FontFamily="{StaticResource toolkit-icons}"
                                                Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                    </Viewbox>
                                </Button>
                            </StackPanel>

                            <Grid Grid.Row="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <controls:OrientedImageDisplay
                                    x:Name="PART_ImageDisplay"
                                    Grid.ColumnSpan="3"
                                    DisplayBackgroundColor="{TemplateBinding DisplayBackgroundColor}" />

                                <Border
                                    Grid.ColumnSpan="3"
                                    Background="#80FFFFFF"
                                    Visibility="{x:Bind local:OrientedImageryResources.VisibleWhenLoading(ViewModel.SelectedImage, IsImageDisplayInteractive), Mode=OneWay}">
                                    <TextBlock
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Text="{internal:LocalizedString Key=OrientedImageryViewLoading}" />
                                </Border>

                                <ProgressBar
                                    Grid.ColumnSpan="3"
                                    Height="2"
                                    VerticalAlignment="Top"
                                    IsIndeterminate="True"
                                    Visibility="{x:Bind local:OrientedImageryResources.VisibleWhenBusy(ViewModel.SelectedImage, IsImageDisplayBusy), Mode=OneWay}" />

                                <Border
                                    Grid.ColumnSpan="3"
                                    Background="#80FFFFFF"
                                    Visibility="{x:Bind local:OrientedImageryResources.VisibleWhenNull(ViewModel.SelectedImage), Mode=OneWay}">
                                    <TextBlock
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Text="{internal:LocalizedString Key=OrientedImageryViewNoImagesSelected}" />
                                </Border>

                                <Border
                                    Grid.ColumnSpan="3"
                                    MaxWidth="300"
                                    Padding="8"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    Visibility="{x:Bind local:OrientedImageryResources.VisibleWhenNotNull(ImageDisplayError), Mode=OneWay}">
                                    <TextBlock Text="{x:Bind ImageDisplayError.Message, Mode=OneWay}" TextWrapping="Wrap" />
                                </Border>

                                <Button
                                    VerticalAlignment="Center"
                                    Command="{x:Bind ViewModel.SelectPreviousImageCommand, Mode=OneWay}"
                                    Style="{StaticResource OrientedImageryNavigationButtonStyle}"
                                    ToolTipService.ToolTip="{internal:LocalizedString Key=OrientedImageryViewPreviousImage}">
                                    <Viewbox Width="20" Height="20" Stretch="Uniform">
                                        <Path Data="M20 26.1 9.9 16 20 5.9z" Fill="{ThemeResource TextFillColorPrimaryBrush}" />
                                    </Viewbox>
                                </Button>

                                <Button
                                    Grid.Column="2"
                                    VerticalAlignment="Center"
                                    Command="{x:Bind ViewModel.SelectNextImageCommand, Mode=OneWay}"
                                    Style="{StaticResource OrientedImageryNavigationButtonStyle}"
                                    ToolTipService.ToolTip="{internal:LocalizedString Key=OrientedImageryViewNextImage}">
                                    <Viewbox Width="20" Height="20" Stretch="Uniform">
                                        <Path Data="M12 5.9 22.1 16 12 26.1z" Fill="{ThemeResource TextFillColorPrimaryBrush}" />
                                    </Viewbox>
                                </Button>
                            </Grid>
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
