<ResourceDictionary
    x:Class="Esri.ArcGISRuntime.Toolkit.OrientedImageryResources"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Esri.ArcGISRuntime.Toolkit.UI.Controls"
    xmlns:symbology="using:Esri.ArcGISRuntime.Symbology"
    xmlns:internal="using:Esri.ArcGISRuntime.Toolkit.Internal"
    xmlns:local="using:Esri.ArcGISRuntime.Toolkit">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="../../../Themes/SharedResources.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <Style x:Key="OrientedImageryToolbarButtonStyle" TargetType="Button">
        <Setter Property="MinWidth" Value="40" />
        <Setter Property="MinHeight" Value="40" />
        <Setter Property="Padding" Value="4" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
    </Style>

    <Style x:Key="OrientedImageryToolbarComboBoxStyle" TargetType="ComboBox">
        <Setter Property="MinWidth" Value="40" />
        <Setter Property="MinHeight" Value="40" />
        <Setter Property="Padding" Value="4" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <Border
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}">
                            <ContentPresenter
                                Margin="{TemplateBinding Padding}"
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                Content="{TemplateBinding SelectedItem}"
                                ContentTemplate="{TemplateBinding ItemTemplate}" />
                        </Border>
                        <Popup x:Name="Popup" ShouldConstrainToRootBounds="False">
                            <Border
                                x:Name="PopupBorder"
                                Background="{ThemeResource ComboBoxDropDownBackground}"
                                BorderBrush="{ThemeResource ComboBoxDropDownBorderBrush}"
                                BorderThickness="{ThemeResource ComboBoxDropdownBorderThickness}"
                                CornerRadius="{ThemeResource OverlayCornerRadius}">
                                <ScrollViewer>
                                    <ItemsPresenter />
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="OrientedImageryToolbarToggleButtonStyle" TargetType="ToggleButton">
        <Setter Property="MinWidth" Value="40" />
        <Setter Property="MinHeight" Value="40" />
        <Setter Property="Padding" Value="4" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
    </Style>

    <Style x:Key="OrientedImageryNavigationButtonStyle" TargetType="Button">
        <Setter Property="Width" Value="32" />
        <Setter Property="MinHeight" Value="60" />
        <Setter Property="Padding" Value="4" />
        <Setter Property="Background" Value="#80FFFFFF" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>

    <Style TargetType="controls:OrientedImageDisplay">
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="controls:OrientedImageDisplay">
                    <Border
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}">
                        <ContentPresenter x:Name="PART_DisplayHost" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="controls:OrientedImageryView">
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="controls:OrientedImageryView">
                    <Border
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <StackPanel x:Name="PART_ToolbarContainer" HorizontalAlignment="Center" Orientation="Horizontal">

                                <ToggleButton
                                    IsChecked="{x:Bind ViewModel.ShowSelectedFootprint, Mode=TwoWay}"
                                    Style="{StaticResource OrientedImageryToolbarToggleButtonStyle}"
                                    ToolTipService.ToolTip="{internal:LocalizedString Key=OrientedImageryViewShowSelectedFootprint}">
                                    <Viewbox Width="30" Height="30" Stretch="Uniform">
                                        <Grid Width="24" Height="24">
                                            <Path Data="F0 M19.384 20H4.616L.349 4h23.302zm-14-1h13.232l3.733-14H1.651z">
                                                <Path.Fill>
                                                    <SolidColorBrush Color="{x:Bind local:OrientedImageryResources.ToWindowsColor(ViewModel.SelectedFootprintOutlineColor), Mode=OneWay}" />
                                                </Path.Fill>
                                            </Path>
                                            <Path Data="m22.35 5-3.73 14H5.38L1.65 5z">
                                                <Path.Fill>
                                                    <SolidColorBrush Color="{x:Bind local:OrientedImageryResources.ToWindowsColor(ViewModel.SelectedFootprintFillColor), Mode=OneWay}" />
                                                </Path.Fill>
                                            </Path>
                                        </Grid>
                                    </Viewbox>
                                </ToggleButton>

                                <ToggleButton
                                    IsChecked="{x:Bind ViewModel.ShowUnselectedFootprints, Mode=TwoWay}"
                                    Style="{StaticResource OrientedImageryToolbarToggleButtonStyle}"
                                    ToolTipService.ToolTip="{internal:LocalizedString Key=OrientedImageryViewShowUnselectedFootprints}">
                                    <Viewbox Width="30" Height="30" Stretch="Uniform">
                                        <Grid Width="24" Height="24">
                                            <Path Data="F0 M19.384 20H4.616L.349 4h23.302zm-14-1h13.232l3.733-14H1.651z">
                                                <Path.Fill>
                                                    <SolidColorBrush Color="{x:Bind local:OrientedImageryResources.ToWindowsColor(ViewModel.UnselectedFootprintOutlineColor), Mode=OneWay}" />
                                                </Path.Fill>
                                            </Path>
                                            <Path Data="m22.35 5-3.73 14H5.38L1.65 5z">
                                                <Path.Fill>
                                                    <SolidColorBrush Color="{x:Bind local:OrientedImageryResources.ToWindowsColor(ViewModel.UnselectedFootprintFillColor), Mode=OneWay}" />
                                                </Path.Fill>
                                            </Path>
                                        </Grid>
                                    </Viewbox>
                                </ToggleButton>

                                <ToggleButton
                                    Command="{x:Bind CameraMarkers.ToggleCameraMarkerDisplayMode, Mode=OneWay}"
                                    Style="{StaticResource OrientedImageryToolbarButtonStyle}"
                                    ToolTipService.ToolTip="{internal:LocalizedString Key=OrientedImageryViewToggleCameraMarkers}">
                                    <Grid Width="32" Height="32" UseLayoutRounding="True">
                                        <Viewbox Width="32" Height="32">
                                            <FontIcon
                                                Glyph="&#xe77a;"
                                                FontSize="32"
                                                FontFamily="{StaticResource toolkit-icons}"
                                                Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                        </Viewbox>
                                    </Grid>
                                </ToggleButton>

                                <ToggleButton
                                    IsChecked="{x:Bind ViewModel.SketchModeEnabled, Mode=TwoWay}"
                                    Style="{StaticResource OrientedImageryToolbarToggleButtonStyle}"
                                    ToolTipService.ToolTip="{internal:LocalizedString Key=OrientedImageryViewToggleAddMarkers}">
                                    <Viewbox Width="32" Height="32" Stretch="Uniform">
                                        <Path
                                            Width="32"
                                            Height="32"
                                            Data="M29 8v15.247l-3.997-3.669a.65.65 0 0 0-.926-.033L21 22.293l-4.554-4.131a.65.65 0 0 0-.857-.013l-5.139 4.268-.826-.391a.64.64 0 0 0-.72.117L5 25.248V20.56l-1-1.006V29h26V7H14v1zm0 20H5v-1.474l4.401-3.5 1.198.567L16 19.106l5 4.531 3.506-3.123L29 24.581zm-8-12a2 2 0 1 0-2-2 2 2 0 0 0 2 2m0-3a1 1 0 1 1-1 1 1 1 0 0 1 1-1M7 19.735l5-5.032V6.038c0-2.493-1.776-3.865-5-3.865-3.178 0-5 1.445-5 3.964v8.566zM3 6.137c0-2.45 2.175-2.964 4-2.964 2.654 0 4 .964 4 2.864v8.254l-4 4.026-4-4.026zM5 8a2 2 0 1 0 2-2 2 2 0 0 0-2 2m3 0a1 1 0 1 1-1-1 1 1 0 0 1 1 1"
                                            Fill="{ThemeResource TextFillColorPrimaryBrush}" />
                                    </Viewbox>
                                </ToggleButton>

                                <ComboBox
                                    ItemsSource="{x:Bind MarkerSymbolPicker.SymbolOptions, Mode=OneWay}"
                                    SelectedItem="{x:Bind MarkerSymbolPicker.SelectedSymbol, Mode=TwoWay}"
                                    Style="{StaticResource OrientedImageryToolbarComboBoxStyle}"
                                    ToolTipService.ToolTip="{internal:LocalizedString Key=OrientedImageryViewSelectMarkerSymbol}"
                                    AutomationProperties.Name="{internal:LocalizedString Key=OrientedImageryViewSelectMarkerSymbol}"
                                    Visibility="{x:Bind local:OrientedImageryResources.VisibleWhen(ViewModel.SketchModeEnabled), Mode=OneWay}">
                                    <ComboBox.ItemContainerStyle>
                                        <Style TargetType="ComboBoxItem">
                                            <Setter Property="MinWidth" Value="40" />
                                            <Setter Property="MinHeight" Value="40" />
                                            <Setter Property="Padding" Value="4" />
                                            <Setter Property="HorizontalContentAlignment" Value="Center" />
                                            <Setter Property="VerticalContentAlignment" Value="Center" />
                                        </Style>
                                    </ComboBox.ItemContainerStyle>
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate x:DataType="symbology:MarkerSymbol">
                                            <controls:SymbolDisplay Width="32" Height="32" Symbol="{x:Bind}" />
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>

                                <Button
                                    Command="{x:Bind ViewModel.ClearMarkersCommand, Mode=OneWay}"
                                    Style="{StaticResource OrientedImageryToolbarButtonStyle}"
                                    ToolTipService.ToolTip="{internal:LocalizedString Key=OrientedImageryViewClearMarkers}">
                                    <Viewbox Width="28" Height="28" Stretch="Uniform">
                                        <Path
                                            Width="32"
                                            Height="32"
                                            Data="M30.102 16.113 15.749 3.388a1.45 1.45 0 0 0-.975-.376 1.3 1.3 0 0 0-.425.067l-14.197 4-.05 1.429c-.067 1.858 1.175 4.718 1.771 6.304a1.3 1.3 0 0 0 .308.486l13.944 14.215a1.42 1.42 0 0 0 1.012.424 1.4 1.4 0 0 0 .538-.105l13.433-5.452c1.877-.752.345-4.776-.568-7.136zM14.62 4.041l.153-.03a.46.46 0 0 1 .304.118l13.423 11.9-11.182 4.193a2.89 2.89 0 0 1-3.049-.661L2.239 7.53zm16.116 19.41L17.3 28.905a.4.4 0 0 1-.162.033.42.42 0 0 1-.3-.126L2.895 14.597a.4.4 0 0 1-.081-.125l-.293-.763c-.585-1.504-1.47-3.776-1.42-5.166l.025-.7 12.436 12.424a3.88 3.88 0 0 0 4.107.89l11.626-4.36.312.806c1.836 4.746 1.497 5.7 1.13 5.847z"
                                            Fill="{ThemeResource TextFillColorPrimaryBrush}" />
                                    </Viewbox>
                                </Button>
                            </StackPanel>

                            <Grid Grid.Row="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <controls:OrientedImageDisplay
                                    x:Name="PART_ImageDisplay"
                                    Grid.ColumnSpan="3"
                                    DisplayBackgroundColor="{TemplateBinding DisplayBackgroundColor}" />

                                <Border
                                    Grid.ColumnSpan="3"
                                    Background="#80FFFFFF"
                                    Visibility="{x:Bind local:OrientedImageryResources.VisibleWhenLoading(ViewModel.SelectedImage, IsImageDisplayInteractive), Mode=OneWay}">
                                    <TextBlock
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Text="{internal:LocalizedString Key=OrientedImageryViewLoading}" />
                                </Border>

                                <ProgressBar
                                    Grid.ColumnSpan="3"
                                    Height="2"
                                    VerticalAlignment="Top"
                                    IsIndeterminate="True"
                                    Visibility="{x:Bind local:OrientedImageryResources.VisibleWhenBusy(ViewModel.SelectedImage, IsImageDisplayBusy), Mode=OneWay}" />

                                <Border
                                    Grid.ColumnSpan="3"
                                    Background="#80FFFFFF"
                                    Visibility="{x:Bind local:OrientedImageryResources.VisibleWhenNull(ViewModel.SelectedImage), Mode=OneWay}">
                                    <TextBlock
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Text="{internal:LocalizedString Key=OrientedImageryViewNoImagesSelected}" />
                                </Border>

                                <Border
                                    Grid.ColumnSpan="3"
                                    MaxWidth="300"
                                    Padding="8"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    Visibility="{x:Bind local:OrientedImageryResources.VisibleWhenNotNull(ImageDisplayError), Mode=OneWay}">
                                    <TextBlock Text="{x:Bind ImageDisplayError.Message, Mode=OneWay}" TextWrapping="Wrap" />
                                </Border>

                                <Button
                                    VerticalAlignment="Center"
                                    Command="{x:Bind ViewModel.SelectPreviousImageCommand, Mode=OneWay}"
                                    Style="{StaticResource OrientedImageryNavigationButtonStyle}"
                                    ToolTipService.ToolTip="{internal:LocalizedString Key=OrientedImageryViewPreviousImage}">
                                    <Viewbox Width="20" Height="20" Stretch="Uniform">
                                        <Path Data="M20 26.1 9.9 16 20 5.9z" Fill="{ThemeResource TextFillColorPrimaryBrush}" />
                                    </Viewbox>
                                </Button>

                                <Button
                                    Grid.Column="2"
                                    VerticalAlignment="Center"
                                    Command="{x:Bind ViewModel.SelectNextImageCommand, Mode=OneWay}"
                                    Style="{StaticResource OrientedImageryNavigationButtonStyle}"
                                    ToolTipService.ToolTip="{internal:LocalizedString Key=OrientedImageryViewNextImage}">
                                    <Viewbox Width="20" Height="20" Stretch="Uniform">
                                        <Path Data="M12 5.9 22.1 16 12 26.1z" Fill="{ThemeResource TextFillColorPrimaryBrush}" />
                                    </Viewbox>
                                </Button>
                            </Grid>
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
