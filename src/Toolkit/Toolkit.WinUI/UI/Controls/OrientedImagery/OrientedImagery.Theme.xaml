    <DataTemplate x:Key="ShowUnselectedFootprintsToolbarTemplate" x:DataType="controls:ShowUnselectedFootprintsVM">
        <ToggleButton
            IsChecked="{x:Bind ViewModel.ShowUnselectedFootprints, Mode=TwoWay}"
            Style="{StaticResource OrientedImageryToolbarToggleButtonStyle}"
            ToolTipService.ToolTip="{internal:LocalizedString Key=OrientedImageryViewShowUnselectedImageFootprints}"
            AutomationProperties.Name="{internal:LocalizedString Key=OrientedImageryViewShowUnselectedImageFootprints}">
            <Viewbox Width="30" Height="30" Stretch="Uniform">
                <Grid Width="32" Height="32">
                    <Path Fill="{ThemeResource TextFillColorPrimaryBrush}" Data="M17.1999 13L22 5H0L9 20H13L13.6 19L19 28H23L32 13H17.1999ZM12.439 19H9.56103L1.7832 6H20.2168L16.0287 13H9.99999L13.0187 18.0311L12.439 19ZM22.439 27H19.561L11.7832 14H30.2168L22.439 27Z" />
                </Grid>
            </Viewbox>
        </ToggleButton>
    </DataTemplate>

    <DataTemplate x:Key="ShowCameraMarkersToolbarTemplate" x:DataType="controls:ShowCameraMarkersVM">
        <ToggleButton
            Command="{x:Bind ToggleCameraMarkerDisplayMode, Mode=OneWay}"
            Style="{StaticResource OrientedImageryToolbarButtonStyle}"
            ToolTipService.ToolTip="{internal:LocalizedString Key=OrientedImageryViewToggleCameraMarkers}">
            <Grid Width="32" Height="32" UseLayoutRounding="True">
                <Viewbox Width="32" Height="32">
                    <FontIcon
                        Glyph="&#xe77a;"
                        FontSize="32"
                        FontFamily="{StaticResource toolkit-icons}"
                        Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                </Viewbox>
            </Grid>
        </ToggleButton>
    </DataTemplate>

    <DataTemplate x:Key="AllowAddingMarkersToolbarTemplate" x:DataType="controls:AllowAddingMarkersVM">
        <ToggleButton
            IsChecked="{x:Bind ViewModel.SketchModeEnabled, Mode=TwoWay}"
            Style="{StaticResource OrientedImageryToolbarToggleButtonStyle}"
            ToolTipService.ToolTip="{internal:LocalizedString Key=OrientedImageryViewToggleAddMarkers}"
            AutomationProperties.Name="{internal:LocalizedString Key=OrientedImageryViewToggleAddMarkers}">
            <Viewbox Width="32" Height="32" Stretch="Uniform">
                <FontIcon
                    Glyph="&#xe8ed;"
                    FontSize="24"
                    FontFamily="{StaticResource toolkit-icons}"
                    Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
            </Viewbox>
        </ToggleButton>
    </DataTemplate>

    <DataTemplate x:Key="MarkerPickerToolbarTemplate" x:DataType="controls:SelectNewMarkerSymbolVM">
        <ComboBox
            ItemsSource="{x:Bind SymbolOptions, Mode=OneWay}"
            SelectedItem="{x:Bind SelectedSymbol, Mode=TwoWay}"
            Style="{StaticResource OrientedImageryToolbarComboBoxStyle}"
            ToolTipService.ToolTip="{internal:LocalizedString Key=OrientedImageryViewSelectMarkerSymbol}"
            AutomationProperties.Name="{internal:LocalizedString Key=OrientedImageryViewSelectMarkerSymbol}"
            Visibility="{x:Bind local:OrientedImageryResources.VisibleWhen(ViewModel.SketchModeEnabled), Mode=OneWay}">
            <ComboBox.ItemContainerStyle>
                <Style TargetType="ComboBoxItem">
                    <Setter Property="MinWidth" Value="40" />
                    <Setter Property="MinHeight" Value="40" />
                    <Setter Property="Padding" Value="4" />
                    <Setter Property="HorizontalContentAlignment" Value="Center" />
                    <Setter Property="VerticalContentAlignment" Value="Center" />
                </Style>
            </ComboBox.ItemContainerStyle>
            <ComboBox.ItemTemplate>
                <DataTemplate x:DataType="symbology:MarkerSymbol">
                    <controls:SymbolDisplay Width="32" Height="32" Symbol="{x:Bind}" />
                </DataTemplate>
            </ComboBox.ItemTemplate>
        </ComboBox>
    </DataTemplate>

    <DataTemplate x:Key="ClearMarkersToolbarTemplate" x:DataType="controls:ClearMarkersVM">
        <Button
            Command="{x:Bind ViewModel.ClearMarkersCommand, Mode=OneWay}"
            Style="{StaticResource OrientedImageryToolbarButtonStyle}"
            ToolTipService.ToolTip="{internal:LocalizedString Key=OrientedImageryViewClearMarkers}"
            AutomationProperties.Name="{internal:LocalizedString Key=OrientedImageryViewClearMarkers}">
            <Viewbox Width="32" Height="32" Stretch="Uniform">
                <FontIcon
                    Glyph="&#xe83e;"
                    FontSize="24"
                    FontFamily="{StaticResource toolkit-icons}" />
            </Viewbox>
        </Button>
    </DataTemplate>

    <DataTemplate x:Key="SequentialNavigationToolbarTemplate" x:DataType="controls:SequentialNavigationVM">
        <Button
            Command="{x:Bind ViewModel.ToggleSequentialNavigationCommand, Mode=OneWay}"
            Style="{StaticResource OrientedImageryToolbarButtonStyle}"
            ToolTipService.ToolTip="{x:Bind local:OrientedImageryResources.SequentialNavigationToolTip(ViewModel.IsSequentialNavigationEnabled), Mode=OneWay}"
            AutomationProperties.Name="{x:Bind local:OrientedImageryResources.SequentialNavigationToolTip(ViewModel.IsSequentialNavigationEnabled), Mode=OneWay}">
            <Viewbox Width="28" Height="28" Stretch="Uniform">
                <Grid Width="32" Height="32">
                    <Path
                        Width="32"
                        Height="32"
                        Stretch="Uniform"
                        Fill="{ThemeResource TextFillColorPrimaryBrush}"
                        Visibility="{x:Bind local:OrientedImageryResources.VisibleWhenFalse(ViewModel.IsSequentialNavigationEnabled), Mode=OneWay}"
