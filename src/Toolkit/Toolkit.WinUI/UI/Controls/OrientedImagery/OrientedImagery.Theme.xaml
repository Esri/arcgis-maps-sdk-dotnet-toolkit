                                                            <ContentControl IsTabStop="False" ContentTemplate="{StaticResource DisplayImageIconTemplate}" />
                                                        </Viewbox>
                                                    </InlineUIContainer>
                                                    <Run Text="{internal:LocalizedString Key=OrientedImageryViewImageSelectionMode}" />
                                                </Paragraph>
