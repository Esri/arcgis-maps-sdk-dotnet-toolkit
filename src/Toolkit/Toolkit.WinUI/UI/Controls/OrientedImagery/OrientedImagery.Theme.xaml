    <Style TargetType="controls:OrientedImageryView">
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="ThemeDisplayBackgroundBrush" Value="{ThemeResource OrientedImageryDisplayBackgroundBrush}" />

        <Setter Property="DefaultToolbarTemplates">
            <Setter.Value>
                <controls:DefaultWinUIToolbarTemplates
                    CategoryTemplate="{StaticResource ToolbarCategoryTemplate}"
                    MoreCategoryTemplate="{StaticResource MoreCategoryTemplate}"
                    ToolbarDividerVMTemplate="{StaticResource ToolbarDividerTemplate}"
