                                    <TextBlock Text="{x:Bind ImageViewportErrorMessage, Mode=OneWay}" TextWrapping="Wrap" />
                                </Border>

                                <Button
                                    Grid.ColumnSpan="3"
                                    Width="35"
                                    Height="35"
                                    MinWidth="0"
                                    MinHeight="0"
                                    Margin="16"
                                    Padding="2"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Top"
                                    Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                    Style="{StaticResource OrientedImageryToolbarButtonStyle}"
                                    Command="{x:Bind ViewModel.OpenSelectedImagePopupCommand, Mode=OneWay}"
                                    Visibility="{TemplateBinding ImageNavigationVisibility}"
                                    AutomationProperties.Name="{internal:LocalizedString Key=OrientedImageryViewOpenSelectedImagePopup}"
                                    ToolTipService.ToolTip="{internal:LocalizedString Key=OrientedImageryViewOpenSelectedImagePopup}">
                                    <PathIcon
                                        Width="31"
                                        Height="31"
                                        Data="F0 M16 3C8.8205 3 3 8.8205 3 16C3 23.1795 8.8205 29 16 29C23.1795 29 29 23.1795 29 16C29 8.8205 23.1795 3 16 3Z M16.0105 8C16.7775 8 17.5 8.673 17.5 9.4905C17.5 10.3635 16.7775 11 16.0105 11C15.1125 11 14.5 10.3635 14.5 9.4905C14.5 8.673 15.1125 8 16.0105 8Z M19.5 23.5H17H15H12.5V22L15 21.5V15H13V13.5L17 13V21.5L19.5 22V23.5Z" />
                                </Button>

                                <Button
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    Command="{x:Bind ViewModel.SelectPreviousImageCommand, Mode=OneWay}"
                                    Style="{StaticResource OrientedImageryNavigationButtonStyle}"
                                    Visibility="{TemplateBinding ImageNavigationVisibility}"
                                    AutomationProperties.Name="{internal:LocalizedString Key=OrientedImageryViewPreviousImage}"
                                    ToolTipService.ToolTip="{internal:LocalizedString Key=OrientedImageryViewPreviousImage}">
                                    <Viewbox Width="20" Height="20" Stretch="Uniform">
                                        <PathIcon Data="M20 26.1 9.9 16 20 5.9z" />
                                    </Viewbox>
                                </Button>

                                <Button
                                    Grid.Column="2"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    Command="{x:Bind ViewModel.SelectNextImageCommand, Mode=OneWay}"
                                    Style="{StaticResource OrientedImageryNavigationButtonStyle}"
                                    Visibility="{TemplateBinding ImageNavigationVisibility}"
                                    AutomationProperties.Name="{internal:LocalizedString Key=OrientedImageryViewNextImage}"
                                    ToolTipService.ToolTip="{internal:LocalizedString Key=OrientedImageryViewNextImage}">
                                    <Viewbox Width="20" Height="20" Stretch="Uniform">
                                        <PathIcon Data="M12 5.9 22.1 16 12 26.1z" />
                                    </Viewbox>
                                </Button>
                            </Grid>

                            <Grid
                                Grid.Row="1"
                                Canvas.ZIndex="2"
                                Visibility="{x:Bind local:OrientedImageryResources.VisibleWhen(IsImageDetailsOpen), Mode=OneWay}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="0.35*" />
                                    <ColumnDefinition Width="0.65*" />
                                </Grid.ColumnDefinitions>
                                <Border
                                    Grid.Column="1"
                                    Background="{ThemeResource OrientedImageryDisplayBackgroundBrush}"
                                    BorderBrush="{ThemeResource OrientedImageryOverlayBorderBrush}"
                                    BorderThickness="1,0,0,0">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                        </Grid.RowDefinitions>
                                        <controls:PopupViewer
                                            Grid.Row="1"
                                            Margin="16,0,8,8"
                                            Popup="{x:Bind ViewModel.SelectedImagePopup, Mode=OneWay}" />
                                        <Button
                                            x:Name="PART_CloseDetailsButton"
                                            Margin="8"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Center"
                                            Command="{x:Bind ViewModel.CloseSelectedImagePopupCommand, Mode=OneWay}"
                                            Style="{StaticResource OrientedImageryToolbarButtonStyle}"
                                            AutomationProperties.Name="{internal:LocalizedString Key=OrientedImageryViewCloseSelectedImagePopup}"
                                            ToolTipService.ToolTip="{internal:LocalizedString Key=OrientedImageryViewCloseSelectedImagePopup}">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <TextBlock
                                                    VerticalAlignment="Center"
                                                    FontSize="16"
                                                    Text="{internal:LocalizedString Key=OrientedImageryViewCloseSelectedImagePopup}" />
                                                <FontIcon Glyph="&#xeb49;" FontSize="20" FontFamily="{StaticResource toolkit-icons}" />
                                            </StackPanel>
                                        </Button>
                                    </Grid>
                                </Border>
                            </Grid>

                            <Border
                                Grid.RowSpan="2"
                                Canvas.ZIndex="3"
                                Padding="16"
                                Background="{ThemeResource OrientedImageryDisplayBackgroundBrush}"
                                Visibility="{x:Bind local:OrientedImageryResources.VisibleWhen(HasViewError), Mode=OneWay}">
                                <TextBlock
                                    MaxWidth="400"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    FontSize="18"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="{x:Bind ErrorMessage, Mode=OneWay}"
                                    TextAlignment="Center"
                                    LineHeight="30"
                                    TextWrapping="Wrap" />
                            </Border>

                            <controls:OrientedImageryPaginator
                                x:Name="PART_Paginator"
                                Grid.Row="2"
                                HorizontalAlignment="Stretch"
                                Style="{StaticResource OrientedImageryPaginatorStyle}"
                                Visibility="{TemplateBinding ResultNavigationVisibility}" />

                            <StackPanel
                                Grid.Row="2"
                                HorizontalAlignment="Center"
                                Orientation="Horizontal"
                                Visibility="{TemplateBinding SequentialNavigationVisibility}">
                                <Button
                                    Style="{StaticResource OrientedImageryPageButtonStyle}"
                                    IsTabStop="False"
                                    Width="33"
                                    Command="{x:Bind ViewModel.SelectPreviousImageCommand, Mode=OneWay}"
                                    ToolTipService.ToolTip="{internal:LocalizedString Key=OrientedImageryViewPreviousImage}"
                                    AutomationProperties.Name="{internal:LocalizedString Key=OrientedImageryViewPreviousImage}">
                                    <FontIcon Glyph="&#xe79f;" FontFamily="{StaticResource toolkit-icons}" FontSize="16" />
                                </Button>
                                <Button
                                    Content="{internal:LocalizedString Key=OrientedImageryViewPreviousLabel}"
                                    AutomationProperties.Name="{internal:LocalizedString Key=OrientedImageryViewPreviousImage}"
                                    ToolTipService.ToolTip="{internal:LocalizedString Key=OrientedImageryViewPreviousImage}"
                                    Style="{StaticResource OrientedImageryPageButtonStyle}"
                                    Command="{x:Bind ViewModel.SelectPreviousImageCommand, Mode=OneWay}" />
                                <Grid Width="35" Height="32">
                                    <TextBlock Text="." HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    <Border
                                        Height="2"
                                        Margin="1,0"
                                        VerticalAlignment="Bottom"
                                        Background="{ThemeResource OrientedImageryPageSelectedBrush}" />
                                </Grid>
                                <Button
                                    Content="{internal:LocalizedString Key=OrientedImageryViewNextLabel}"
                                    AutomationProperties.Name="{internal:LocalizedString Key=OrientedImageryViewNextImage}"
                                    ToolTipService.ToolTip="{internal:LocalizedString Key=OrientedImageryViewNextImage}"
                                    Style="{StaticResource OrientedImageryPageButtonStyle}"
                                    Command="{x:Bind ViewModel.SelectNextImageCommand, Mode=OneWay}" />
                                <Button
                                    Style="{StaticResource OrientedImageryPageButtonStyle}"
                                    IsTabStop="False"
                                    Width="33"
                                    Command="{x:Bind ViewModel.SelectNextImageCommand, Mode=OneWay}"
                                    ToolTipService.ToolTip="{internal:LocalizedString Key=OrientedImageryViewNextImage}"
                                    AutomationProperties.Name="{internal:LocalizedString Key=OrientedImageryViewNextImage}">
                                    <FontIcon Glyph="&#xe7a0;" FontFamily="{StaticResource toolkit-icons}" FontSize="16" />
                                </Button>
                            </StackPanel>
                            <TextBlock
                                Grid.Row="3"
                                Margin="8,0,8,4"
                                Text="{x:Bind ViewModel.SequentialNavigationError.Message, Mode=OneWay}"
                                TextAlignment="Center"
                                TextWrapping="Wrap"
                                Visibility="{x:Bind local:OrientedImageryResources.VisibleWhen(HasSequentialNavigationError), Mode=OneWay}" />
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
