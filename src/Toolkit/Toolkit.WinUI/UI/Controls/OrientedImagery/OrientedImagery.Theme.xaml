<ResourceDictionary
    x:Class="Esri.ArcGISRuntime.Toolkit.OrientedImageryResources"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Esri.ArcGISRuntime.Toolkit.UI.Controls"
    xmlns:symbology="using:Esri.ArcGISRuntime.Symbology"
    xmlns:internal="using:Esri.ArcGISRuntime.Toolkit.Internal"
    xmlns:local="using:Esri.ArcGISRuntime.Toolkit">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="../../../Themes/SharedResources.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <!-- Helper Styles -->

    <Style x:Key="OrientedImageryToolbarButtonStyle" TargetType="Button">
        <Setter Property="MinWidth" Value="40" />
        <Setter Property="MinHeight" Value="40" />
        <Setter Property="Padding" Value="4" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
    </Style>

    <Style x:Key="OrientedImageryToolbarComboBoxStyle" TargetType="ComboBox">
        <Setter Property="MinWidth" Value="40" />
        <Setter Property="MinHeight" Value="40" />
        <Setter Property="Padding" Value="4" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <Border
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}">
                            <ContentPresenter
                                Margin="{TemplateBinding Padding}"
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                Content="{TemplateBinding SelectedItem}"
                                ContentTemplate="{TemplateBinding ItemTemplate}" />
                        </Border>
                        <Popup x:Name="Popup" ShouldConstrainToRootBounds="False">
                            <Border
                                x:Name="PopupBorder"
                                Background="{ThemeResource ComboBoxDropDownBackground}"
                                BorderBrush="{ThemeResource ComboBoxDropDownBorderBrush}"
                                BorderThickness="{ThemeResource ComboBoxDropdownBorderThickness}"
                                CornerRadius="{ThemeResource OverlayCornerRadius}">
                                <ScrollViewer>
                                    <ItemsPresenter />
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="OrientedImageryToolbarToggleButtonStyle" TargetType="ToggleButton">
        <Setter Property="MinWidth" Value="40" />
        <Setter Property="MinHeight" Value="40" />
        <Setter Property="Padding" Value="4" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
    </Style>

    <Style x:Key="OrientedImageryNavigationButtonStyle" TargetType="Button">
        <Setter Property="Width" Value="32" />
        <Setter Property="MinHeight" Value="60" />
        <Setter Property="Padding" Value="4" />
        <Setter Property="Background" Value="#80FFFFFF" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>

    <!-- Toolbar Data Templates -->

    <Style x:Key="ToolbarContainerStyle" TargetType="ItemsControl">
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="ItemsPanel">
            <Setter.Value>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" />
                </ItemsPanelTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <DataTemplate x:Key="ToolbarCategoryTemplate" x:DataType="controls:OrientedImageryToolbarCategory">
        <ItemsControl
            ItemsSource="{x:Bind ToolbarItems, Mode=OneWay}"
            Loaded="ToolbarCategory_Loaded"
            Style="{StaticResource ToolbarContainerStyle}" />
    </DataTemplate>

    <DataTemplate x:Key="MoreCategoryTemplate" x:DataType="controls:OrientedImageryToolbarCategory">
        <ItemsControl
            ItemsSource="{x:Bind ToolbarItems, Mode=OneWay}"
            Loaded="ToolbarCategory_Loaded"
            Style="{StaticResource ToolbarContainerStyle}"
            Visibility="{x:Bind local:OrientedImageryResources.VisibleWhen(ViewModel.SupportsSequentialNavigation), Mode=OneWay}" />
    </DataTemplate>

    <DataTemplate x:Key="ToolbarDividerTemplate" x:DataType="controls:ToolbarDividerVM">
        <Border
            Width="1"
            Height="28"
            Margin="8,6"
            Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
    </DataTemplate>

    <DataTemplate x:Key="ImageSearchModeToolbarTemplate" x:DataType="controls:ImageSearchModeVM">
        <Button
            IsEnabled="False"
            Content="{internal:LocalizedString Key=OrientedImageryViewImageSearchMode}"
            AutomationProperties.Name="{internal:LocalizedString Key=OrientedImageryViewImageSearchMode}"
            Style="{StaticResource OrientedImageryToolbarButtonStyle}" />
    </DataTemplate>

    <DataTemplate x:Key="SequentialNavigationToolbarTemplate" x:DataType="controls:SequentialNavigationVM">
        <Button
            IsEnabled="False"
            Content="{internal:LocalizedString Key=EnterSequentialNavigationModeLabel}"
            AutomationProperties.Name="{internal:LocalizedString Key=EnterSequentialNavigationModeLabel}"
            Style="{StaticResource OrientedImageryToolbarButtonStyle}" />
    </DataTemplate>

    <DataTemplate x:Key="ShowSelectedFootprintToolbarTemplate" x:DataType="controls:ShowSelectedFootprintVM">
        <ToggleButton
            IsChecked="{x:Bind ViewModel.ShowSelectedFootprint, Mode=TwoWay}"
            Style="{StaticResource OrientedImageryToolbarToggleButtonStyle}"
            ToolTipService.ToolTip="{internal:LocalizedString Key=OrientedImageryViewShowSelectedFootprint}">
            <Viewbox Width="30" Height="30" Stretch="Uniform">
                <Grid Width="24" Height="24">
                    <Path Data="F0 M19.384 20H4.616L.349 4h23.302z">
                        <Path.Fill>
                            <SolidColorBrush Color="{x:Bind local:OrientedImageryResources.ToWindowsColor(ViewModel.SelectedFootprintFillColor), Mode=OneWay}" />
                        </Path.Fill>
                        <Path.Stroke>
                            <SolidColorBrush Color="{x:Bind local:OrientedImageryResources.ToWindowsColor(ViewModel.SelectedFootprintOutlineColor), Mode=OneWay}" />
                        </Path.Stroke>
                    </Path>
                </Grid>
            </Viewbox>
        </ToggleButton>
    </DataTemplate>

    <DataTemplate x:Key="ShowUnselectedFootprintsToolbarTemplate" x:DataType="controls:ShowUnselectedFootprintsVM">
        <ToggleButton
            IsChecked="{x:Bind ViewModel.ShowUnselectedFootprints, Mode=TwoWay}"
            Style="{StaticResource OrientedImageryToolbarToggleButtonStyle}"
            ToolTipService.ToolTip="{internal:LocalizedString Key=OrientedImageryViewShowUnselectedFootprints}">
            <Viewbox Width="30" Height="30" Stretch="Uniform">
                <Grid Width="24" Height="24">
                    <Path Data="F0 M19.384 20H4.616L.349 4h23.302z">
                        <Path.Fill>
                            <SolidColorBrush Color="{x:Bind local:OrientedImageryResources.ToWindowsColor(ViewModel.UnselectedFootprintFillColor), Mode=OneWay}" />
                        </Path.Fill>
                        <Path.Stroke>
                            <SolidColorBrush Color="{x:Bind local:OrientedImageryResources.ToWindowsColor(ViewModel.UnselectedFootprintOutlineColor), Mode=OneWay}" />
                        </Path.Stroke>
                    </Path>
                </Grid>
            </Viewbox>
        </ToggleButton>
    </DataTemplate>

    <DataTemplate x:Key="ShowCameraMarkersToolbarTemplate" x:DataType="controls:ShowCameraMarkersVM">
        <ToggleButton
            Command="{x:Bind ToggleCameraMarkerDisplayMode, Mode=OneWay}"
            Style="{StaticResource OrientedImageryToolbarButtonStyle}"
            ToolTipService.ToolTip="{internal:LocalizedString Key=OrientedImageryViewToggleCameraMarkers}">
            <Grid Width="32" Height="32" UseLayoutRounding="True">
                <Viewbox Width="32" Height="32">
                    <FontIcon
                        Glyph="&#xe77a;"
                        FontSize="32"
                        FontFamily="{StaticResource toolkit-icons}"
                        Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                </Viewbox>
            </Grid>
        </ToggleButton>
    </DataTemplate>

    <DataTemplate x:Key="AllowAddingMarkersToolbarTemplate" x:DataType="controls:AllowAddingMarkersVM">
        <ToggleButton
            IsChecked="{x:Bind IsAddingMarkersEnabled, Mode=TwoWay}"
            Style="{StaticResource OrientedImageryToolbarToggleButtonStyle}"
            ToolTipService.ToolTip="{internal:LocalizedString Key=OrientedImageryViewToggleAddMarkers}">
            <Viewbox Width="32" Height="32" Stretch="Uniform">
                <FontIcon
                    Glyph="&#xe8ed;"
                    FontSize="24"
                    FontFamily="{StaticResource toolkit-icons}"
                    Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
            </Viewbox>
        </ToggleButton>
    </DataTemplate>

    <DataTemplate x:Key="MarkerPickerToolbarTemplate" x:DataType="controls:SelectNewMarkerSymbolVM">
        <ComboBox
            ItemsSource="{x:Bind SymbolOptions, Mode=OneWay}"
            SelectedItem="{x:Bind SelectedSymbol, Mode=TwoWay}"
            Style="{StaticResource OrientedImageryToolbarComboBoxStyle}"
            ToolTipService.ToolTip="{internal:LocalizedString Key=OrientedImageryViewSelectMarkerSymbol}"
            AutomationProperties.Name="{internal:LocalizedString Key=OrientedImageryViewSelectMarkerSymbol}"
            Visibility="{x:Bind local:OrientedImageryResources.VisibleWhenAddingMarkers(ViewModel.InteractionState), Mode=OneWay}">
            <ComboBox.ItemContainerStyle>
                <Style TargetType="ComboBoxItem">
                    <Setter Property="MinWidth" Value="40" />
                    <Setter Property="MinHeight" Value="40" />
                    <Setter Property="Padding" Value="4" />
                    <Setter Property="HorizontalContentAlignment" Value="Center" />
                    <Setter Property="VerticalContentAlignment" Value="Center" />
                </Style>
            </ComboBox.ItemContainerStyle>
            <ComboBox.ItemTemplate>
                <DataTemplate x:DataType="symbology:MarkerSymbol">
                    <controls:SymbolDisplay Width="32" Height="32" Symbol="{x:Bind}" />
                </DataTemplate>
            </ComboBox.ItemTemplate>
        </ComboBox>
    </DataTemplate>

    <DataTemplate x:Key="ClearMarkersToolbarTemplate" x:DataType="controls:ClearMarkersVM">
        <Button
            Command="{x:Bind ViewModel.ClearMarkersCommand, Mode=OneWay}"
            Style="{StaticResource OrientedImageryToolbarButtonStyle}"
            ToolTipService.ToolTip="{internal:LocalizedString Key=OrientedImageryViewClearMarkers}">
            <Viewbox Width="32" Height="32" Stretch="Uniform">
                <FontIcon
                    Glyph="&#xe83e;"
                    FontSize="24"
                    FontFamily="{StaticResource toolkit-icons}"
                    Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
            </Viewbox>
        </Button>
    </DataTemplate>

    <!-- OrientedImageDisplay Style -->

    <Style TargetType="controls:OrientedImageViewport">
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="controls:OrientedImageViewport">
                    <Border
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}">
                        <Border x:Name="PART_DisplayHost" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- OrientedImageryView Style -->

    <Style TargetType="controls:OrientedImageryView">
        <Setter Property="IsTabStop" Value="False" />

        <Setter Property="DefaultToolbarTemplates">
            <Setter.Value>
                <controls:DefaultWinUIToolbarTemplates
                    CategoryTemplate="{StaticResource ToolbarCategoryTemplate}"
                    MoreCategoryTemplate="{StaticResource MoreCategoryTemplate}"
                    ToolbarDividerVMTemplate="{StaticResource ToolbarDividerTemplate}"
                    ImageSearchModeVMTemplate="{StaticResource ImageSearchModeToolbarTemplate}"
                    SequentialNavigationVMTemplate="{StaticResource SequentialNavigationToolbarTemplate}"
                    AllowAddingMarkersVMTemplate="{StaticResource AllowAddingMarkersToolbarTemplate}"
                    ClearMarkersVMTemplate="{StaticResource ClearMarkersToolbarTemplate}"
                    MarkerPickerVMTemplate="{StaticResource MarkerPickerToolbarTemplate}"
                    ShowCameraMarkersVMTemplate="{StaticResource ShowCameraMarkersToolbarTemplate}"
                    ShowSelectedFootprintVMTemplate="{StaticResource ShowSelectedFootprintToolbarTemplate}"
                    ShowUnselectedFootprintsVMTemplate="{StaticResource ShowUnselectedFootprintsToolbarTemplate}" />
            </Setter.Value>
        </Setter>

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="controls:OrientedImageryView">
                    <Border
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <ItemsControl x:Name="PART_ToolbarContainer" Style="{StaticResource ToolbarContainerStyle}" />

                            <Grid Grid.Row="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <controls:OrientedImageViewport
                                    x:Name="PART_ImageViewport"
                                    Grid.ColumnSpan="3"
                                    DisplayBackgroundColor="{TemplateBinding DisplayBackgroundColor}" />

                                <Border
                                    Grid.ColumnSpan="3"
                                    Background="#80FFFFFF"
                                    Visibility="{x:Bind local:OrientedImageryResources.VisibleWhenLoading(ViewModel.SelectedImage, IsImageViewportInteractive), Mode=OneWay}">
                                    <TextBlock
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Text="{internal:LocalizedString Key=OrientedImageryViewLoading}" />
                                </Border>

                                <ProgressBar
                                    Grid.ColumnSpan="3"
                                    Height="2"
                                    VerticalAlignment="Top"
                                    IsIndeterminate="True"
                                    Visibility="{x:Bind local:OrientedImageryResources.VisibleWhenBusy(ViewModel.SelectedImage, IsImageViewportBusy), Mode=OneWay}" />

                                <Border
                                    Grid.ColumnSpan="3"
                                    Background="#80FFFFFF"
                                    Visibility="{x:Bind local:OrientedImageryResources.VisibleWhenNull(ViewModel.SelectedImage), Mode=OneWay}">
                                    <TextBlock
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Text="{internal:LocalizedString Key=OrientedImageryViewNoImageToDisplay}" />
                                </Border>

                                <Border
                                    Grid.ColumnSpan="3"
                                    MaxWidth="300"
                                    Padding="8"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    Visibility="{x:Bind local:OrientedImageryResources.VisibleWhenNotNull(ImageViewportError), Mode=OneWay}">
                                    <TextBlock Text="{x:Bind ImageViewportError.Message, Mode=OneWay}" TextWrapping="Wrap" />
                                </Border>

                                <Button
                                    VerticalAlignment="Center"
                                    Command="{x:Bind ViewModel.SelectPreviousImageCommand, Mode=OneWay}"
                                    Style="{StaticResource OrientedImageryNavigationButtonStyle}"
                                    ToolTipService.ToolTip="{internal:LocalizedString Key=OrientedImageryViewPreviousImage}">
                                    <Viewbox Width="20" Height="20" Stretch="Uniform">
                                        <Path Data="M20 26.1 9.9 16 20 5.9z" Fill="{ThemeResource TextFillColorPrimaryBrush}" />
                                    </Viewbox>
                                </Button>

                                <Button
                                    Grid.Column="2"
                                    VerticalAlignment="Center"
                                    Command="{x:Bind ViewModel.SelectNextImageCommand, Mode=OneWay}"
                                    Style="{StaticResource OrientedImageryNavigationButtonStyle}"
                                    ToolTipService.ToolTip="{internal:LocalizedString Key=OrientedImageryViewNextImage}">
                                    <Viewbox Width="20" Height="20" Stretch="Uniform">
                                        <Path Data="M12 5.9 22.1 16 12 26.1z" Fill="{ThemeResource TextFillColorPrimaryBrush}" />
                                    </Viewbox>
                                </Button>
                            </Grid>
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
