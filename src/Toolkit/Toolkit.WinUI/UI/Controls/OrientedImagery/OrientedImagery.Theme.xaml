            <x:Double x:Key="OrientedImageryPressedContentOpacity">0.7</x:Double>
        </ResourceDictionary>
        <ResourceDictionary x:Key="Light">
            <StaticResource x:Key="OrientedImageryDisabledForegroundBrush" ResourceKey="TextFillColorPrimaryBrush" />
            <StaticResource x:Key="OrientedImageryNavigationHoverBackgroundBrush" ResourceKey="ControlFillColorSecondaryBrush" />
            <StaticResource x:Key="OrientedImageryNavigationPressedBackgroundBrush" ResourceKey="ControlFillColorTertiaryBrush" />
