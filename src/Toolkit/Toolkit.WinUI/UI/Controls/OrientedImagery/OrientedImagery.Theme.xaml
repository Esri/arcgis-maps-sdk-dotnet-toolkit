        <Button
            Command="{x:Bind ViewModel.ToggleSequentialNavigationCommand, Mode=OneWay}"
            Style="{StaticResource OrientedImageryToolbarButtonStyle}"
            ToolTipService.ToolTip="{x:Bind local:OrientedImageryResources.SequentialNavigationToolTip(ViewModel.IsSequentialNavigationEnabled), Mode=OneWay}"
