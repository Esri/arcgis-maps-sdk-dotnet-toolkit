    </DataTemplate>

    <!-- OrientedImageDisplay Style -->

    <Style TargetType="controls:OrientedImageDisplay">
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="controls:OrientedImageDisplay">
                    <Border
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}">
                        <ContentPresenter x:Name="PART_DisplayHost" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ToolbarContainer Style -->
    <Style x:Key="ToolbarContainerStyle" TargetType="ItemsControl">
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ItemsControl">
                    <ItemsPresenter HorizontalAlignment="Stretch" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="ItemsPanel">
            <Setter.Value>
                <ItemsPanelTemplate>
                    <controls:OrientedImageryToolbarPanel />
                </ItemsPanelTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- OrientedImageryView Style -->

    <Style TargetType="controls:OrientedImageryView">
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="ThemeDisplayBackgroundColor" Value="{ThemeResource OrientedImageryDisplayBackgroundColor}" />

        <Setter Property="DefaultToolbarTemplates">
            <Setter.Value>
                <controls:DefaultWinUIToolbarTemplates
                    ImageSearchModeVMTemplate="{StaticResource ImageSearchModeToolbarTemplate}"
                    AllowAddingMarkersVMTemplate="{StaticResource AllowAddingMarkersToolbarTemplate}"
                    ClearMarkersVMTemplate="{StaticResource ClearMarkersToolbarTemplate}"
                    MarkerPickerVMTemplate="{StaticResource MarkerPickerToolbarTemplate}"
                    ShowCameraMarkersVMTemplate="{StaticResource ShowCameraMarkersToolbarTemplate}"
                    ShowSelectedFootprintVMTemplate="{StaticResource ShowSelectedFootprintToolbarTemplate}"
                    ShowUnselectedFootprintsVMTemplate="{StaticResource ShowUnselectedFootprintsToolbarTemplate}"
                    SequentialNavigationVMTemplate="{StaticResource SequentialNavigationToolbarTemplate}" />
            </Setter.Value>
        </Setter>

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="controls:OrientedImageryView">
                    <Border
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <ItemsControl x:Name="PART_ToolbarContainer" Style="{StaticResource ToolbarContainerStyle}" />

                            <Grid Grid.Row="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <controls:OrientedImageDisplay
                                    x:Name="PART_ImageDisplay"
                                    Grid.ColumnSpan="3" />

                                <Border
                                    Grid.ColumnSpan="3"
                                    Background="{ThemeResource OrientedImageryOverlayBackgroundBrush}"
                                    Visibility="{x:Bind local:OrientedImageryResources.VisibleWhenLoading(ViewModel.SelectedImage, IsImageDisplayInteractive), Mode=OneWay}">
                                    <TextBlock
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Text="{internal:LocalizedString Key=OrientedImageryViewLoading}" />
                                </Border>

                                <ProgressBar
                                    Grid.ColumnSpan="3"
                                    Height="2"
                                    VerticalAlignment="Top"
                                    IsIndeterminate="True"
                                    Visibility="{x:Bind local:OrientedImageryResources.VisibleWhenBusy(ViewModel.SelectedImage, IsImageDisplayBusy), Mode=OneWay}" />

                                <Border
                                    Grid.ColumnSpan="3"
                                    Background="{ThemeResource OrientedImageryOverlayBackgroundBrush}"
                                    Visibility="{TemplateBinding NoImageSelectedVisibility}">
                                    <TextBlock
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Text="{internal:LocalizedString Key=OrientedImageryViewNoImagesSelected}" />
                                </Border>

                                <Border
                                    Grid.ColumnSpan="3"
                                    MaxWidth="300"
                                    Padding="8"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Background="{ThemeResource OrientedImageryOverlayBackgroundBrush}"
                                    BorderBrush="{ThemeResource OrientedImageryOverlayBorderBrush}"
                                    BorderThickness="1"
                                    Visibility="{x:Bind local:OrientedImageryResources.VisibleWhenNotNull(ImageDisplayError), Mode=OneWay}">
                                    <TextBlock Text="{x:Bind ImageDisplayError.Message, Mode=OneWay}" TextWrapping="Wrap" />
                                </Border>

                                <Button
                                    VerticalAlignment="Center"
                                    Command="{x:Bind ViewModel.SelectPreviousImageCommand, Mode=OneWay}"
                                    Style="{StaticResource OrientedImageryNavigationButtonStyle}"
                                    Visibility="{TemplateBinding ImageNavigationVisibility}"
                                    ToolTipService.ToolTip="{internal:LocalizedString Key=OrientedImageryViewPreviousImage}">
                                    <Viewbox Width="20" Height="20" Stretch="Uniform">
                                        <PathIcon Data="M20 26.1 9.9 16 20 5.9z" />
                                    </Viewbox>
                                </Button>

                                <Button
                                    Grid.Column="2"
                                    VerticalAlignment="Center"
                                    Command="{x:Bind ViewModel.SelectNextImageCommand, Mode=OneWay}"
                                    Style="{StaticResource OrientedImageryNavigationButtonStyle}"
                                    Visibility="{TemplateBinding ImageNavigationVisibility}"
                                    ToolTipService.ToolTip="{internal:LocalizedString Key=OrientedImageryViewNextImage}">
                                    <Viewbox Width="20" Height="20" Stretch="Uniform">
                                        <PathIcon Data="M12 5.9 22.1 16 12 26.1z" />
                                    </Viewbox>
                                </Button>
                            </Grid>

                            <controls:OrientedImageryPaginator
                                x:Name="PART_Paginator"
                                Grid.Row="2"
                                HorizontalAlignment="Stretch"
                                Style="{StaticResource OrientedImageryPaginatorStyle}"
                                Visibility="{TemplateBinding ResultNavigationVisibility}" />

                            <StackPanel
                                Grid.Row="2"
                                HorizontalAlignment="Center"
                                Orientation="Horizontal"
                                Visibility="{TemplateBinding SequentialNavigationVisibility}">
                                <Button
                                    Style="{StaticResource OrientedImageryPageButtonStyle}"
                                    Width="33"
                                    Command="{x:Bind ViewModel.SelectPreviousImageCommand, Mode=OneWay}"
                                    ToolTipService.ToolTip="{internal:LocalizedString Key=OrientedImageryViewPreviousImage}"
                                    AutomationProperties.Name="{internal:LocalizedString Key=OrientedImageryViewPreviousImage}">
                                    <FontIcon Glyph="&#xe79f;" FontFamily="{StaticResource toolkit-icons}" FontSize="16" />
                                </Button>
                                <Button
                                    Content="{internal:LocalizedString Key=OrientedImageryViewPreviousLabel}"
                                    ToolTipService.ToolTip="{internal:LocalizedString Key=OrientedImageryViewPreviousImage}"
                                    Style="{StaticResource OrientedImageryPageButtonStyle}"
                                    Command="{x:Bind ViewModel.SelectPreviousImageCommand, Mode=OneWay}" />
                                <Grid Width="35" Height="32">
                                    <TextBlock Text="." HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    <Border
                                        Height="2"
                                        Margin="1,0"
                                        VerticalAlignment="Bottom"
                                        Background="{ThemeResource OrientedImageryPageSelectedBrush}" />
                                </Grid>
                                <Button
                                    Content="{internal:LocalizedString Key=OrientedImageryViewNextLabel}"
                                    ToolTipService.ToolTip="{internal:LocalizedString Key=OrientedImageryViewNextImage}"
                                    Style="{StaticResource OrientedImageryPageButtonStyle}"
                                    Command="{x:Bind ViewModel.SelectNextImageCommand, Mode=OneWay}" />
                                <Button
                                    Style="{StaticResource OrientedImageryPageButtonStyle}"
                                    Width="33"
                                    Command="{x:Bind ViewModel.SelectNextImageCommand, Mode=OneWay}"
                                    ToolTipService.ToolTip="{internal:LocalizedString Key=OrientedImageryViewNextImage}"
                                    AutomationProperties.Name="{internal:LocalizedString Key=OrientedImageryViewNextImage}">
                                    <FontIcon Glyph="&#xe7a0;" FontFamily="{StaticResource toolkit-icons}" FontSize="16" />
                                </Button>
                            </StackPanel>
                            <TextBlock
                                Grid.Row="3"
                                Margin="8,0,8,4"
                                Text="{x:Bind ViewModel.SequentialNavigationError, Mode=OneWay}"
                                TextAlignment="Center"
                                TextWrapping="Wrap"
                                Visibility="{x:Bind local:OrientedImageryResources.VisibleWhenNotNull(ViewModel.SequentialNavigationError), Mode=OneWay}" />
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
