                    ClearMarkersVMTemplate="{StaticResource ClearMarkersToolbarTemplate}"
                    MarkerPickerVMTemplate="{StaticResource MarkerPickerToolbarTemplate}"
                    ShowCameraMarkersVMTemplate="{StaticResource ShowCameraMarkersToolbarTemplate}"
                    ShowSelectedFootprintVMTemplate="{StaticResource ShowSelectedFootprintToolbarTemplate}"
                    ShowUnselectedFootprintsVMTemplate="{StaticResource ShowUnselectedFootprintsToolbarTemplate}" />
            </Setter.Value>
        </Setter>

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="controls:OrientedImageryView">
                    <Border
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <ItemsControl
                                x:Name="PART_ToolbarContainer"
                                IsTabStop="False"
                                Style="{StaticResource ToolbarContainerStyle}"
                                Visibility="{x:Bind local:OrientedImageryResources.VisibleWhenFalse(HasViewError), Mode=OneWay}" />

                            <Grid Grid.Row="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <controls:OrientedImageViewport
                                    x:Name="PART_ImageViewport"
                                    Grid.ColumnSpan="3"
                                    DisplayBackgroundColor="{TemplateBinding DisplayBackgroundColor}" />

                                        <Border
                                    Grid.ColumnSpan="3"
                                    Background="#80FFFFFF"
                                    Visibility="{x:Bind local:OrientedImageryResources.VisibleWhenLoading(ViewModel.SelectedImage, IsImageViewportInteractive), Mode=OneWay}">
                                            <TextBlock
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Text="{internal:LocalizedString Key=OrientedImageryViewLoading}" />
                                </Border>

                                <ProgressBar
                                    Grid.ColumnSpan="3"
                                    Height="2"
                                    VerticalAlignment="Top"
                                    IsIndeterminate="True"
                                    Visibility="{x:Bind local:OrientedImageryResources.VisibleWhenBusy(ViewModel.SelectedImage, IsImageViewportBusy), Mode=OneWay}" />

                                <Border
                                    Grid.ColumnSpan="3"
                                    Background="{ThemeResource OrientedImageryDisplayBackgroundBrush}"
                                    Visibility="{TemplateBinding NoImageSelectedVisibility}">
                                    <StackPanel
                                        MaxWidth="400"
                                        Margin="16"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center">
                                        <TextBlock
                                            Margin="0,0,0,6"
                                            FontSize="18"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
