<ResourceDictionary
    x:Class="Esri.ArcGISRuntime.Toolkit.OrientedImageryResources"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Esri.ArcGISRuntime.Toolkit.UI.Controls"
    xmlns:symbology="using:Esri.ArcGISRuntime.Symbology"
    xmlns:internal="using:Esri.ArcGISRuntime.Toolkit.Internal"
    xmlns:local="using:Esri.ArcGISRuntime.Toolkit">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="../../../Themes/SharedResources.xaml" />
    </ResourceDictionary.MergedDictionaries>
    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Default">
            <StaticResource x:Key="OrientedImageryDisabledForegroundBrush" ResourceKey="TextFillColorPrimaryBrush" />
            <StaticResource x:Key="OrientedImageryNavigationHoverBackgroundBrush" ResourceKey="ControlFillColorSecondaryBrush" />
            <StaticResource x:Key="OrientedImageryNavigationPressedBackgroundBrush" ResourceKey="ControlFillColorTertiaryBrush" />
            <StaticResource x:Key="OrientedImageryNavigationActiveForegroundBrush" ResourceKey="TextFillColorPrimaryBrush" />
            <StaticResource x:Key="OrientedImageryDisplayBackgroundColor" ResourceKey="SolidBackgroundFillColorBase" />
            <StaticResource x:Key="OrientedImageryButtonHoverBackgroundBrush" ResourceKey="ControlFillColorSecondaryBrush" />
            <StaticResource x:Key="OrientedImageryButtonHoverBorderBrush" ResourceKey="TextFillColorSecondaryBrush" />
            <StaticResource x:Key="OrientedImageryButtonPressedBackgroundBrush" ResourceKey="ControlFillColorTertiaryBrush" />
            <StaticResource x:Key="OrientedImageryButtonPressedBorderBrush" ResourceKey="TextFillColorPrimaryBrush" />
            <StaticResource x:Key="OrientedImageryButtonSelectedBackgroundBrush" ResourceKey="SystemControlBackgroundBaseLowBrush" />
            <StaticResource x:Key="OrientedImageryButtonSelectedHoverBackgroundBrush" ResourceKey="SystemControlBackgroundBaseMediumLowBrush" />
            <StaticResource x:Key="OrientedImageryButtonSelectedBorderBrush" ResourceKey="TextFillColorPrimaryBrush" />
            <StaticResource x:Key="OrientedImageryButtonDisabledBorderBrush" ResourceKey="TextFillColorDisabledBrush" />
            <StaticResource x:Key="OrientedImageryPageSelectedBrush" ResourceKey="AccentFillColorDefaultBrush" />
            <StaticResource x:Key="OrientedImageryOverlayBackgroundBrush" ResourceKey="CardBackgroundFillColorDefaultBrush" />
            <StaticResource x:Key="OrientedImageryOverlayBorderBrush" ResourceKey="CardStrokeColorDefaultBrush" />
            <x:Double x:Key="OrientedImageryDisabledContentOpacity">0.35</x:Double>
            <x:Double x:Key="OrientedImageryPressedContentOpacity">0.7</x:Double>
        </ResourceDictionary>
        <ResourceDictionary x:Key="Light">
            <StaticResource x:Key="OrientedImageryDisabledForegroundBrush" ResourceKey="TextFillColorPrimaryBrush" />
            <StaticResource x:Key="OrientedImageryNavigationHoverBackgroundBrush" ResourceKey="ControlFillColorSecondaryBrush" />
            <StaticResource x:Key="OrientedImageryNavigationPressedBackgroundBrush" ResourceKey="ControlFillColorTertiaryBrush" />
            <StaticResource x:Key="OrientedImageryNavigationActiveForegroundBrush" ResourceKey="TextFillColorPrimaryBrush" />
            <StaticResource x:Key="OrientedImageryDisplayBackgroundColor" ResourceKey="SolidBackgroundFillColorBase" />
            <StaticResource x:Key="OrientedImageryButtonHoverBackgroundBrush" ResourceKey="ControlFillColorSecondaryBrush" />
            <StaticResource x:Key="OrientedImageryButtonHoverBorderBrush" ResourceKey="TextFillColorSecondaryBrush" />
            <StaticResource x:Key="OrientedImageryButtonPressedBackgroundBrush" ResourceKey="ControlFillColorTertiaryBrush" />
            <StaticResource x:Key="OrientedImageryButtonPressedBorderBrush" ResourceKey="TextFillColorPrimaryBrush" />
            <StaticResource x:Key="OrientedImageryButtonSelectedBackgroundBrush" ResourceKey="SystemControlBackgroundBaseLowBrush" />
            <StaticResource x:Key="OrientedImageryButtonSelectedHoverBackgroundBrush" ResourceKey="SystemControlBackgroundBaseMediumLowBrush" />
            <StaticResource x:Key="OrientedImageryButtonSelectedBorderBrush" ResourceKey="TextFillColorPrimaryBrush" />
            <StaticResource x:Key="OrientedImageryButtonDisabledBorderBrush" ResourceKey="TextFillColorDisabledBrush" />
            <StaticResource x:Key="OrientedImageryPageSelectedBrush" ResourceKey="AccentFillColorDefaultBrush" />
            <StaticResource x:Key="OrientedImageryOverlayBackgroundBrush" ResourceKey="CardBackgroundFillColorDefaultBrush" />
            <StaticResource x:Key="OrientedImageryOverlayBorderBrush" ResourceKey="CardStrokeColorDefaultBrush" />
            <x:Double x:Key="OrientedImageryDisabledContentOpacity">0.35</x:Double>
            <x:Double x:Key="OrientedImageryPressedContentOpacity">0.7</x:Double>
        </ResourceDictionary>
        <ResourceDictionary x:Key="HighContrast">
            <SolidColorBrush x:Key="OrientedImageryDisabledForegroundBrush" Color="{ThemeResource SystemColorGrayTextColor}" />
            <SolidColorBrush x:Key="OrientedImageryNavigationHoverBackgroundBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="OrientedImageryNavigationPressedBackgroundBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="OrientedImageryNavigationActiveForegroundBrush" Color="{ThemeResource SystemColorHighlightTextColor}" />
            <StaticResource x:Key="OrientedImageryDisplayBackgroundColor" ResourceKey="SystemColorWindowColor" />
            <SolidColorBrush x:Key="OrientedImageryButtonHoverBackgroundBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="OrientedImageryButtonHoverBorderBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="OrientedImageryButtonPressedBackgroundBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="OrientedImageryButtonPressedBorderBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="OrientedImageryButtonSelectedBackgroundBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="OrientedImageryButtonSelectedHoverBackgroundBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="OrientedImageryButtonSelectedBorderBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="OrientedImageryButtonDisabledBorderBrush" Color="{ThemeResource SystemColorGrayTextColor}" />
            <SolidColorBrush x:Key="OrientedImageryPageSelectedBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="OrientedImageryOverlayBackgroundBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="OrientedImageryOverlayBorderBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <x:Double x:Key="OrientedImageryDisabledContentOpacity">1</x:Double>
            <x:Double x:Key="OrientedImageryPressedContentOpacity">1</x:Double>
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

    <!-- Helper Styles -->

    <ControlTemplate x:Key="OrientedImageryButtonTemplate" TargetType="ButtonBase">
        <Border
            x:Name="Root"
            Background="{TemplateBinding Background}"
            BorderBrush="{TemplateBinding BorderBrush}"
            BorderThickness="{TemplateBinding BorderThickness}"
            CornerRadius="{TemplateBinding CornerRadius}">
            <VisualStateManager.VisualStateGroups>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="PointerOver">
                        <VisualState.Setters>
                            <Setter Target="Root.Background" Value="{ThemeResource OrientedImageryButtonHoverBackgroundBrush}" />
                            <Setter Target="Root.BorderBrush" Value="{ThemeResource OrientedImageryButtonHoverBorderBrush}" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Pressed">
                        <VisualState.Setters>
                            <Setter Target="Root.Background" Value="{ThemeResource OrientedImageryButtonPressedBackgroundBrush}" />
                            <Setter Target="Root.BorderBrush" Value="{ThemeResource OrientedImageryButtonPressedBorderBrush}" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <Setter Target="ButtonContent.Foreground" Value="{ThemeResource OrientedImageryDisabledForegroundBrush}" />
                            <Setter Target="ButtonContent.Opacity" Value="{ThemeResource OrientedImageryDisabledContentOpacity}" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Checked">
                        <VisualState.Setters>
                            <Setter Target="Root.Background" Value="{ThemeResource OrientedImageryButtonSelectedBackgroundBrush}" />
                            <Setter Target="Root.BorderBrush" Value="{ThemeResource OrientedImageryButtonSelectedBorderBrush}" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="CheckedPointerOver">
                        <VisualState.Setters>
                            <Setter Target="Root.Background" Value="{ThemeResource OrientedImageryButtonSelectedHoverBackgroundBrush}" />
                            <Setter Target="Root.BorderBrush" Value="{ThemeResource OrientedImageryButtonSelectedBorderBrush}" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="CheckedPressed">
                        <VisualState.Setters>
                            <Setter Target="Root.Background" Value="{ThemeResource OrientedImageryButtonSelectedHoverBackgroundBrush}" />
                            <Setter Target="Root.BorderBrush" Value="{ThemeResource OrientedImageryButtonSelectedBorderBrush}" />
                            <Setter Target="ButtonContent.Opacity" Value="{ThemeResource OrientedImageryPressedContentOpacity}" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="CheckedDisabled">
                        <VisualState.Setters>
                            <Setter Target="ButtonContent.Foreground" Value="{ThemeResource OrientedImageryDisabledForegroundBrush}" />
                            <Setter Target="Root.BorderBrush" Value="{ThemeResource OrientedImageryButtonDisabledBorderBrush}" />
                            <Setter Target="ButtonContent.Opacity" Value="{ThemeResource OrientedImageryDisabledContentOpacity}" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
            <ContentPresenter
                x:Name="ButtonContent"
                Margin="{TemplateBinding Padding}"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Content="{TemplateBinding Content}"
                ContentTemplate="{TemplateBinding ContentTemplate}"
                Foreground="{TemplateBinding Foreground}" />
        </Border>
    </ControlTemplate>

    <Style x:Key="OrientedImageryToolbarButtonStyle" TargetType="Button">
        <Setter Property="MinWidth" Value="44" />
        <Setter Property="MinHeight" Value="44" />
        <Setter Property="Padding" Value="4" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="UseSystemFocusVisuals" Value="True" />
        <Setter Property="Template" Value="{StaticResource OrientedImageryButtonTemplate}" />
    </Style>

    <Style x:Key="OrientedImageryToolbarComboBoxStyle" TargetType="ComboBox">
        <Setter Property="MinWidth" Value="40" />
        <Setter Property="MinHeight" Value="40" />
        <Setter Property="Padding" Value="4" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <Border
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}">
                            <ContentPresenter
                                Margin="{TemplateBinding Padding}"
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                Content="{TemplateBinding SelectedItem}"
                                ContentTemplate="{TemplateBinding ItemTemplate}" />
                        </Border>
                        <Popup x:Name="Popup" ShouldConstrainToRootBounds="False">
                            <Border
                                x:Name="PopupBorder"
                                Background="{ThemeResource ComboBoxDropDownBackground}"
                                BorderBrush="{ThemeResource ComboBoxDropDownBorderBrush}"
                                BorderThickness="{ThemeResource ComboBoxDropdownBorderThickness}"
                                CornerRadius="{ThemeResource OverlayCornerRadius}">
                                <ScrollViewer>
                                    <ItemsPresenter />
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="OrientedImageryToolbarToggleButtonStyle" TargetType="ToggleButton">
        <Setter Property="MinWidth" Value="44" />
        <Setter Property="MinHeight" Value="44" />
        <Setter Property="Padding" Value="4" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="UseSystemFocusVisuals" Value="True" />
        <Setter Property="Template" Value="{StaticResource OrientedImageryButtonTemplate}" />
    </Style>

    <ControlTemplate x:Key="OrientedImageryNavigationButtonTemplate" TargetType="Button">
        <Border
            x:Name="Root"
            Background="{TemplateBinding Background}"
            BorderBrush="{TemplateBinding BorderBrush}"
            BorderThickness="{TemplateBinding BorderThickness}"
            CornerRadius="{TemplateBinding CornerRadius}">
            <VisualStateManager.VisualStateGroups>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="PointerOver">
                        <VisualState.Setters>
                            <Setter Target="Root.Background" Value="{ThemeResource OrientedImageryNavigationHoverBackgroundBrush}" />
                            <Setter Target="ButtonContent.Foreground" Value="{ThemeResource OrientedImageryNavigationActiveForegroundBrush}" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Pressed">
                        <VisualState.Setters>
                            <Setter Target="Root.Background" Value="{ThemeResource OrientedImageryNavigationPressedBackgroundBrush}" />
                            <Setter Target="ButtonContent.Foreground" Value="{ThemeResource OrientedImageryNavigationActiveForegroundBrush}" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <Setter Target="ButtonContent.Foreground" Value="{ThemeResource OrientedImageryDisabledForegroundBrush}" />
                            <Setter Target="ButtonContent.Opacity" Value="{ThemeResource OrientedImageryDisabledContentOpacity}" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
            <ContentPresenter
                x:Name="ButtonContent"
                Margin="{TemplateBinding Padding}"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Content="{TemplateBinding Content}"
                ContentTemplate="{TemplateBinding ContentTemplate}"
                Foreground="{TemplateBinding Foreground}" />
        </Border>
    </ControlTemplate>

    <Style x:Key="OrientedImageryNavigationButtonStyle" TargetType="Button">
        <Setter Property="Width" Value="32" />
        <Setter Property="MinHeight" Value="60" />
        <Setter Property="Padding" Value="4" />
        <Setter Property="Background" Value="{ThemeResource OrientedImageryOverlayBackgroundBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Template" Value="{StaticResource OrientedImageryNavigationButtonTemplate}" />
    </Style>

    <Style x:Key="OrientedImageryPageButtonStyle" TargetType="Button">
        <Setter Property="Height" Value="32" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Template" Value="{StaticResource OrientedImageryNavigationButtonTemplate}" />
    </Style>

    <Style x:Key="OrientedImageryPaginatorStyle" TargetType="controls:OrientedImageryPaginator">
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="controls:OrientedImageryPaginator">
                    <Grid Height="32" HorizontalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Button
                            x:Name="PART_PreviousPage"
                            Width="33"
                            Style="{StaticResource OrientedImageryPageButtonStyle}"
                            ToolTipService.ToolTip="{internal:LocalizedString Key=OrientedImageryViewPreviousImage}"
                            AutomationProperties.Name="{internal:LocalizedString Key=OrientedImageryViewPreviousImage}">
                            <FontIcon Glyph="&#xe79f;" FontFamily="{StaticResource toolkit-icons}" FontSize="16" />
                        </Button>
                        <ItemsControl x:Name="PART_PagesPresenter" Grid.Column="1" IsTabStop="False">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel HorizontalAlignment="Center" Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="controls:OrientedImageryPage">
                                    <Grid Width="{x:Bind Width}" Height="32">
                                        <Button
                                            Content="{x:Bind Number}"
                                            Command="{x:Bind SelectCommand}"
                                            Width="{x:Bind Width}"
                                            Style="{StaticResource OrientedImageryPageButtonStyle}"
                                            AutomationProperties.Name="{x:Bind Number}" />
                                        <Border
                                            Height="2"
                                            Margin="1,0"
                                            VerticalAlignment="Bottom"
                                            Background="{ThemeResource OrientedImageryPageSelectedBrush}"
                                            IsHitTestVisible="False"
                                            Visibility="{x:Bind SelectedIndicatorVisibility}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Button
                            x:Name="PART_NextPage"
                            Grid.Column="2"
                            Width="33"
                            Style="{StaticResource OrientedImageryPageButtonStyle}"
                            ToolTipService.ToolTip="{internal:LocalizedString Key=OrientedImageryViewNextImage}"
                            AutomationProperties.Name="{internal:LocalizedString Key=OrientedImageryViewNextImage}">
                            <FontIcon Glyph="&#xe7a0;" FontFamily="{StaticResource toolkit-icons}" FontSize="16" />
                        </Button>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Toolbar Data Templates -->

    <DataTemplate x:Key="ImageSearchModeToolbarTemplate" x:DataType="controls:ImageSearchModeVM">
        <Button Content="SearchModePlaceholder" Command="{Binding ToggleImageSearchModeCommand}" />
    </DataTemplate>

