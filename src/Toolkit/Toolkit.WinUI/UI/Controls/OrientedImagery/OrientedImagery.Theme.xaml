<ResourceDictionary
    x:Class="Esri.ArcGISRuntime.Toolkit.OrientedImageryResources"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Esri.ArcGISRuntime.Toolkit.UI.Controls"
    xmlns:symbology="using:Esri.ArcGISRuntime.Symbology"
    xmlns:internal="using:Esri.ArcGISRuntime.Toolkit.Internal"
    xmlns:local="using:Esri.ArcGISRuntime.Toolkit">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="../../../Themes/SharedResources.xaml" />
    </ResourceDictionary.MergedDictionaries>
    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Default">
            <StaticResource x:Key="OrientedImageryDisabledForegroundBrush" ResourceKey="TextFillColorPrimaryBrush" />
            <SolidColorBrush x:Key="OrientedImageryNavigationBackgroundBrush" Color="#202020" />
            <SolidColorBrush x:Key="OrientedImageryNavigationForegroundBrush" Color="White" />
            <SolidColorBrush x:Key="OrientedImageryNavigationHoverBackgroundBrush" Color="#303030" />
            <SolidColorBrush x:Key="OrientedImageryNavigationPressedBackgroundBrush" Color="#404040" />
            <SolidColorBrush x:Key="OrientedImageryNavigationActiveForegroundBrush" Color="White" />
            <SolidColorBrush x:Key="OrientedImageryDisplayBackgroundBrush" Color="{ThemeResource SolidBackgroundFillColorBase}" />
            <StaticResource x:Key="OrientedImageryButtonHoverBackgroundBrush" ResourceKey="ControlFillColorSecondaryBrush" />
            <StaticResource x:Key="OrientedImageryButtonHoverBorderBrush" ResourceKey="TextFillColorSecondaryBrush" />
            <StaticResource x:Key="OrientedImageryButtonPressedBackgroundBrush" ResourceKey="ControlFillColorTertiaryBrush" />
            <StaticResource x:Key="OrientedImageryButtonPressedBorderBrush" ResourceKey="TextFillColorPrimaryBrush" />
            <StaticResource x:Key="OrientedImageryButtonSelectedBackgroundBrush" ResourceKey="SystemControlBackgroundBaseLowBrush" />
            <StaticResource x:Key="OrientedImageryButtonSelectedHoverBackgroundBrush" ResourceKey="SystemControlBackgroundBaseMediumLowBrush" />
            <StaticResource x:Key="OrientedImageryButtonSelectedBorderBrush" ResourceKey="TextFillColorPrimaryBrush" />
            <StaticResource x:Key="OrientedImageryButtonDisabledBorderBrush" ResourceKey="TextFillColorDisabledBrush" />
            <StaticResource x:Key="OrientedImageryPageSelectedBrush" ResourceKey="AccentFillColorDefaultBrush" />
            <StaticResource x:Key="OrientedImageryOverlayBackgroundBrush" ResourceKey="CardBackgroundFillColorDefaultBrush" />
            <StaticResource x:Key="OrientedImageryOverlayBorderBrush" ResourceKey="CardStrokeColorDefaultBrush" />
            <x:Double x:Key="OrientedImageryDisabledContentOpacity">0.35</x:Double>
            <x:Double x:Key="OrientedImageryPressedContentOpacity">0.7</x:Double>
        </ResourceDictionary>
        <ResourceDictionary x:Key="Light">
            <StaticResource x:Key="OrientedImageryDisabledForegroundBrush" ResourceKey="TextFillColorPrimaryBrush" />
            <SolidColorBrush x:Key="OrientedImageryNavigationBackgroundBrush" Color="White" />
            <SolidColorBrush x:Key="OrientedImageryNavigationForegroundBrush" Color="#202020" />
            <SolidColorBrush x:Key="OrientedImageryNavigationHoverBackgroundBrush" Color="#EFEFEF" />
            <SolidColorBrush x:Key="OrientedImageryNavigationPressedBackgroundBrush" Color="#D3D3D3" />
            <SolidColorBrush x:Key="OrientedImageryNavigationActiveForegroundBrush" Color="#202020" />
            <SolidColorBrush x:Key="OrientedImageryDisplayBackgroundBrush" Color="{ThemeResource SolidBackgroundFillColorBase}" />
            <StaticResource x:Key="OrientedImageryButtonHoverBackgroundBrush" ResourceKey="ControlFillColorSecondaryBrush" />
            <StaticResource x:Key="OrientedImageryButtonHoverBorderBrush" ResourceKey="TextFillColorSecondaryBrush" />
            <StaticResource x:Key="OrientedImageryButtonPressedBackgroundBrush" ResourceKey="ControlFillColorTertiaryBrush" />
            <StaticResource x:Key="OrientedImageryButtonPressedBorderBrush" ResourceKey="TextFillColorPrimaryBrush" />
            <StaticResource x:Key="OrientedImageryButtonSelectedBackgroundBrush" ResourceKey="SystemControlBackgroundBaseLowBrush" />
            <StaticResource x:Key="OrientedImageryButtonSelectedHoverBackgroundBrush" ResourceKey="SystemControlBackgroundBaseMediumLowBrush" />
            <StaticResource x:Key="OrientedImageryButtonSelectedBorderBrush" ResourceKey="TextFillColorPrimaryBrush" />
            <StaticResource x:Key="OrientedImageryButtonDisabledBorderBrush" ResourceKey="TextFillColorDisabledBrush" />
            <StaticResource x:Key="OrientedImageryPageSelectedBrush" ResourceKey="AccentFillColorDefaultBrush" />
            <StaticResource x:Key="OrientedImageryOverlayBackgroundBrush" ResourceKey="CardBackgroundFillColorDefaultBrush" />
            <StaticResource x:Key="OrientedImageryOverlayBorderBrush" ResourceKey="CardStrokeColorDefaultBrush" />
            <x:Double x:Key="OrientedImageryDisabledContentOpacity">0.35</x:Double>
            <x:Double x:Key="OrientedImageryPressedContentOpacity">0.7</x:Double>
        </ResourceDictionary>
        <ResourceDictionary x:Key="HighContrast">
            <SolidColorBrush x:Key="OrientedImageryDisabledForegroundBrush" Color="{ThemeResource SystemColorGrayTextColor}" />
            <SolidColorBrush x:Key="OrientedImageryNavigationBackgroundBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="OrientedImageryNavigationForegroundBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="OrientedImageryNavigationHoverBackgroundBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="OrientedImageryNavigationPressedBackgroundBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="OrientedImageryNavigationActiveForegroundBrush" Color="{ThemeResource SystemColorHighlightTextColor}" />
            <SolidColorBrush x:Key="OrientedImageryDisplayBackgroundBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="OrientedImageryButtonHoverBackgroundBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="OrientedImageryButtonHoverBorderBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="OrientedImageryButtonPressedBackgroundBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="OrientedImageryButtonPressedBorderBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="OrientedImageryButtonSelectedBackgroundBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="OrientedImageryButtonSelectedHoverBackgroundBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="OrientedImageryButtonSelectedBorderBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="OrientedImageryButtonDisabledBorderBrush" Color="{ThemeResource SystemColorGrayTextColor}" />
            <SolidColorBrush x:Key="OrientedImageryPageSelectedBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="OrientedImageryOverlayBackgroundBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="OrientedImageryOverlayBorderBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <x:Double x:Key="OrientedImageryDisabledContentOpacity">1</x:Double>
            <x:Double x:Key="OrientedImageryPressedContentOpacity">1</x:Double>
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

    <!-- Helper Styles -->

    <ControlTemplate x:Key="OrientedImageryButtonTemplate" TargetType="ButtonBase">
        <Border
            x:Name="Root"
            Background="{TemplateBinding Background}"
            BorderBrush="{TemplateBinding BorderBrush}"
            BorderThickness="{TemplateBinding BorderThickness}"
            CornerRadius="{TemplateBinding CornerRadius}">
            <VisualStateManager.VisualStateGroups>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="PointerOver">
                        <VisualState.Setters>
                            <Setter Target="Root.Background" Value="{ThemeResource OrientedImageryButtonHoverBackgroundBrush}" />
                            <Setter Target="Root.BorderBrush" Value="{ThemeResource OrientedImageryButtonHoverBorderBrush}" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Pressed">
                        <VisualState.Setters>
                            <Setter Target="Root.Background" Value="{ThemeResource OrientedImageryButtonPressedBackgroundBrush}" />
                            <Setter Target="Root.BorderBrush" Value="{ThemeResource OrientedImageryButtonPressedBorderBrush}" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <Setter Target="Root.BorderBrush" Value="Transparent" />
                            <Setter Target="ButtonContent.Foreground" Value="{ThemeResource OrientedImageryDisabledForegroundBrush}" />
                            <Setter Target="ButtonContent.Opacity" Value="{ThemeResource OrientedImageryDisabledContentOpacity}" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Checked">
                        <VisualState.Setters>
                            <Setter Target="Root.Background" Value="{ThemeResource OrientedImageryButtonSelectedBackgroundBrush}" />
                            <Setter Target="Root.BorderBrush" Value="{ThemeResource OrientedImageryButtonSelectedBorderBrush}" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="CheckedPointerOver">
                        <VisualState.Setters>
                            <Setter Target="Root.Background" Value="{ThemeResource OrientedImageryButtonSelectedHoverBackgroundBrush}" />
                            <Setter Target="Root.BorderBrush" Value="{ThemeResource OrientedImageryButtonSelectedBorderBrush}" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="CheckedPressed">
                        <VisualState.Setters>
                            <Setter Target="Root.Background" Value="{ThemeResource OrientedImageryButtonSelectedHoverBackgroundBrush}" />
                            <Setter Target="Root.BorderBrush" Value="{ThemeResource OrientedImageryButtonSelectedBorderBrush}" />
                            <Setter Target="ButtonContent.Opacity" Value="{ThemeResource OrientedImageryPressedContentOpacity}" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="CheckedDisabled">
                        <VisualState.Setters>
                            <Setter Target="ButtonContent.Foreground" Value="{ThemeResource OrientedImageryDisabledForegroundBrush}" />
                            <Setter Target="Root.BorderBrush" Value="Transparent" />
                            <Setter Target="ButtonContent.Opacity" Value="{ThemeResource OrientedImageryDisabledContentOpacity}" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
            <ContentControl
                x:Name="ButtonContent"
                IsTabStop="False"
                Margin="{TemplateBinding Padding}"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                HorizontalContentAlignment="Center"
                VerticalContentAlignment="Center"
                Content="{TemplateBinding Content}"
                ContentTemplate="{TemplateBinding ContentTemplate}"
                Foreground="{TemplateBinding Foreground}" />
        </Border>
    </ControlTemplate>

    <Style x:Key="OrientedImageryToolbarButtonStyle" TargetType="Button">
        <Setter Property="MinWidth" Value="44" />
        <Setter Property="MinHeight" Value="44" />
        <Setter Property="Padding" Value="4" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="UseSystemFocusVisuals" Value="True" />
        <Setter Property="Template" Value="{StaticResource OrientedImageryButtonTemplate}" />
    </Style>

    <Style x:Key="OrientedImageryToolbarComboBoxStyle" TargetType="ComboBox">
        <Setter Property="MinWidth" Value="16" />
        <Setter Property="MinHeight" Value="84" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="UseSystemFocusVisuals" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="Root.Background" Value="{ThemeResource OrientedImageryButtonHoverBackgroundBrush}" />
                                        <Setter Target="Root.BorderBrush" Value="{ThemeResource OrientedImageryButtonHoverBorderBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <VisualState.Setters>
                                        <Setter Target="Root.Background" Value="{ThemeResource OrientedImageryButtonPressedBackgroundBrush}" />
                                        <Setter Target="Root.BorderBrush" Value="{ThemeResource OrientedImageryButtonPressedBorderBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Disabled">
                                    <VisualState.Setters>
                                        <Setter Target="Root.Opacity" Value="{ThemeResource OrientedImageryDisabledContentOpacity}" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <Border
                            x:Name="Root"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}">
                            <StackPanel Spacing="8" VerticalAlignment="Center">
                                <Viewbox MinWidth="16" MaxWidth="20" Height="32" Stretch="Uniform">
                                    <ContentPresenter
                                        Content="{TemplateBinding SelectedItem}"
                                        ContentTemplate="{TemplateBinding ItemTemplate}"
                                        Foreground="{TemplateBinding Foreground}" />
                                </Viewbox>
                                <Grid Height="32">
                                    <FontIcon Glyph="&#xE70D;" FontSize="12" Foreground="{TemplateBinding Foreground}" />
                                </Grid>
                            </StackPanel>
                        </Border>
                        <Popup x:Name="Popup" ShouldConstrainToRootBounds="False">
                            <Border
                                x:Name="PopupBorder"
                                Background="{ThemeResource ComboBoxDropDownBackground}"
                                BorderBrush="{ThemeResource ComboBoxDropDownBorderBrush}"
                                BorderThickness="{ThemeResource ComboBoxDropdownBorderThickness}"
                                CornerRadius="{ThemeResource OverlayCornerRadius}">
                                <ScrollViewer>
                                    <ItemsPresenter />
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ImageSearchModeComboBoxStyle" TargetType="ComboBox" BasedOn="{StaticResource OrientedImageryToolbarComboBoxStyle}">
        <Setter Property="MinWidth" Value="16" />
        <Setter Property="MinHeight" Value="84" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="UseSystemFocusVisuals" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="Root.Background" Value="{ThemeResource OrientedImageryButtonHoverBackgroundBrush}" />
                                        <Setter Target="Root.BorderBrush" Value="{ThemeResource OrientedImageryButtonHoverBorderBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <VisualState.Setters>
                                        <Setter Target="Root.Background" Value="{ThemeResource OrientedImageryButtonPressedBackgroundBrush}" />
                                        <Setter Target="Root.BorderBrush" Value="{ThemeResource OrientedImageryButtonPressedBorderBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Disabled">
                                    <VisualState.Setters>
                                        <Setter Target="Root.Opacity" Value="{ThemeResource OrientedImageryDisabledContentOpacity}" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <Border
                            x:Name="Root"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}">
                            <StackPanel Spacing="8" VerticalAlignment="Center">
                                <Grid Width="16" Height="32" />
                                <Grid Height="32">
                                    <FontIcon Glyph="&#xE70D;" FontSize="12" Foreground="{TemplateBinding Foreground}" />
                                </Grid>
                            </StackPanel>
                        </Border>
                        <Popup x:Name="Popup" ShouldConstrainToRootBounds="False">
                            <Border
                                x:Name="PopupBorder"
                                Background="{ThemeResource ComboBoxDropDownBackground}"
                                BorderBrush="{ThemeResource ComboBoxDropDownBorderBrush}"
                                BorderThickness="{ThemeResource ComboBoxDropdownBorderThickness}"
                                CornerRadius="{ThemeResource OverlayCornerRadius}">
                                <ScrollViewer>
                                    <ItemsPresenter />
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="OrientedImageryToolbarToggleButtonStyle" TargetType="ToggleButton">
        <Setter Property="MinWidth" Value="44" />
        <Setter Property="MinHeight" Value="44" />
        <Setter Property="Padding" Value="4" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="UseSystemFocusVisuals" Value="True" />
        <Setter Property="Template" Value="{StaticResource OrientedImageryButtonTemplate}" />
    </Style>

    <Style x:Key="OrientedImageryToolbarLabeledButtonStyle" TargetType="Button" BasedOn="{StaticResource OrientedImageryToolbarButtonStyle}">
        <Setter Property="MinWidth" Value="76" />
        <Setter Property="MinHeight" Value="84" />
    </Style>

    <Style x:Key="OrientedImageryToolbarLabeledToggleButtonStyle" TargetType="ToggleButton" BasedOn="{StaticResource OrientedImageryToolbarToggleButtonStyle}">
        <Setter Property="MinWidth" Value="76" />
        <Setter Property="MinHeight" Value="84" />
    </Style>

    <Style x:Key="OrientedImageryToolbarLabelStyle" TargetType="TextBlock">
        <Setter Property="Width" Value="68" />
        <Setter Property="Height" Value="32" />
        <Setter Property="Margin" Value="0,8,0,0" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="TextAlignment" Value="Center" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="HorizontalAlignment" Value="Center" />
    </Style>

    <ControlTemplate x:Key="OrientedImageryNavigationButtonTemplate" TargetType="Button">
        <Border
            x:Name="Root"
            Background="{TemplateBinding Background}"
            BorderBrush="{TemplateBinding BorderBrush}"
            BorderThickness="{TemplateBinding BorderThickness}"
            CornerRadius="{TemplateBinding CornerRadius}">
            <VisualStateManager.VisualStateGroups>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="PointerOver">
                        <VisualState.Setters>
                            <Setter Target="Root.Background" Value="{ThemeResource OrientedImageryNavigationHoverBackgroundBrush}" />
                            <Setter Target="ButtonContent.Foreground" Value="{ThemeResource OrientedImageryNavigationActiveForegroundBrush}" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Pressed">
                        <VisualState.Setters>
                            <Setter Target="Root.Background" Value="{ThemeResource OrientedImageryNavigationPressedBackgroundBrush}" />
                            <Setter Target="ButtonContent.Foreground" Value="{ThemeResource OrientedImageryNavigationActiveForegroundBrush}" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <Setter Target="ButtonContent.Foreground" Value="{ThemeResource OrientedImageryDisabledForegroundBrush}" />
                            <Setter Target="ButtonContent.Opacity" Value="{ThemeResource OrientedImageryDisabledContentOpacity}" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
            <ContentPresenter
                x:Name="ButtonContent"
                Margin="{TemplateBinding Padding}"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Content="{TemplateBinding Content}"
                ContentTemplate="{TemplateBinding ContentTemplate}"
                Foreground="{TemplateBinding Foreground}" />
        </Border>
    </ControlTemplate>

    <Style x:Key="OrientedImageryNavigationButtonStyle" TargetType="Button">
        <Setter Property="Width" Value="28" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="MinHeight" Value="60" />
        <Setter Property="Padding" Value="4" />
        <Setter Property="Background" Value="{ThemeResource OrientedImageryNavigationBackgroundBrush}" />
        <Setter Property="Foreground" Value="{ThemeResource OrientedImageryNavigationForegroundBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Template" Value="{StaticResource OrientedImageryNavigationButtonTemplate}" />
    </Style>

    <Style x:Key="OrientedImageryPageButtonStyle" TargetType="Button">
        <Setter Property="Height" Value="32" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Template" Value="{StaticResource OrientedImageryNavigationButtonTemplate}" />
    </Style>

    <Style x:Key="OrientedImageryPaginatorStyle" TargetType="controls:OrientedImageryPaginator">
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="controls:OrientedImageryPaginator">
                    <Grid Height="32" HorizontalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Button
                            x:Name="PART_PreviousPage"
                            IsTabStop="False"
                            Width="33"
                            Style="{StaticResource OrientedImageryPageButtonStyle}"
                            ToolTipService.ToolTip="{internal:LocalizedString Key=OrientedImageryViewPreviousImage}"
                            AutomationProperties.Name="{internal:LocalizedString Key=OrientedImageryViewPreviousImage}">
                            <FontIcon Glyph="&#xe79f;" FontFamily="{StaticResource toolkit-icons}" FontSize="16" />
                        </Button>
                        <ItemsControl x:Name="PART_PagesPresenter" Grid.Column="1" IsTabStop="False">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel HorizontalAlignment="Center" Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="controls:OrientedImageryPage">
                                    <Grid Width="{x:Bind Width, Mode=OneWay}" Height="32">
                                        <Button
                                            Content="{x:Bind Number, Mode=OneWay}"
                                            Command="{x:Bind SelectCommand}"
                                            Width="{x:Bind Width, Mode=OneWay}"
                                            Style="{StaticResource OrientedImageryPageButtonStyle}"
                                            IsTabStop="{x:Bind IsTabStop, Mode=OneWay}"
                                            AutomationProperties.Name="{x:Bind AutomationName, Mode=OneWay}" />
                                        <Border
                                            Height="2"
                                            Margin="1,0"
                                            VerticalAlignment="Bottom"
                                            Background="{ThemeResource OrientedImageryPageSelectedBrush}"
                                            IsHitTestVisible="False"
                                            Visibility="{x:Bind SelectedIndicatorVisibility, Mode=OneWay}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Button
                            x:Name="PART_NextPage"
                            IsTabStop="False"
                            Grid.Column="2"
                            Width="33"
                            Style="{StaticResource OrientedImageryPageButtonStyle}"
                            ToolTipService.ToolTip="{internal:LocalizedString Key=OrientedImageryViewNextImage}"
                            AutomationProperties.Name="{internal:LocalizedString Key=OrientedImageryViewNextImage}">
                            <FontIcon Glyph="&#xe7a0;" FontFamily="{StaticResource toolkit-icons}" FontSize="16" />
                        </Button>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Toolbar Data Templates -->

    <DataTemplate x:Key="ToolbarCategoryTemplate" x:DataType="controls:OrientedImageryToolbarCategory">
        <ItemsControl
            ItemsSource="{x:Bind ToolbarItems, Mode=OneWay}"
            Loaded="ToolbarCategory_Loaded"
            Style="{StaticResource ToolbarContainerStyle}" />
    </DataTemplate>

    <DataTemplate x:Key="MoreCategoryTemplate" x:DataType="controls:OrientedImageryToolbarCategory">
        <ItemsControl
            ItemsSource="{x:Bind ToolbarItems, Mode=OneWay}"
            Loaded="ToolbarCategory_Loaded"
            Style="{StaticResource ToolbarContainerStyle}"
            Visibility="{x:Bind local:OrientedImageryResources.VisibleWhen(ViewModel.SupportsSequentialNavigation), Mode=OneWay}" />
    </DataTemplate>

    <DataTemplate x:Key="ToolbarDividerTemplate" x:DataType="controls:ToolbarDividerVM">
        <Border
            Width="1"
            Height="72"
            Margin="8,6"
            Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
    </DataTemplate>

    <local:ImageSearchModeLabelConverter x:Key="ImageSearchModeLabelConverter" />
    <local:NotNullToBooleanConverter x:Key="NotNullToBooleanConverter" />

    <DataTemplate x:Key="DisplayImageIconTemplate">
