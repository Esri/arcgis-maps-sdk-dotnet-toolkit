    <!-- OrientedImageryView Style -->

    <Style TargetType="controls:OrientedImageryView">
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="ThemeDisplayBackgroundBrush" Value="{ThemeResource OrientedImageryDisplayBackgroundBrush}" />

        <Setter Property="DefaultToolbarTemplates">
            <Setter.Value>
                <controls:DefaultWinUIToolbarTemplates
                    CategoryTemplate="{StaticResource ToolbarCategoryTemplate}"
                    MoreCategoryTemplate="{StaticResource MoreCategoryTemplate}"
                    ToolbarDividerVMTemplate="{StaticResource ToolbarDividerTemplate}"
                    ImageSearchModeVMTemplate="{StaticResource ImageSearchModeToolbarTemplate}"
                    SequentialNavigationVMTemplate="{StaticResource SequentialNavigationToolbarTemplate}"
                    AllowAddingMarkersVMTemplate="{StaticResource AllowAddingMarkersToolbarTemplate}"
                    ClearMarkersVMTemplate="{StaticResource ClearMarkersToolbarTemplate}"
                    MarkerPickerVMTemplate="{StaticResource MarkerPickerToolbarTemplate}"
                    ShowCameraMarkersVMTemplate="{StaticResource ShowCameraMarkersToolbarTemplate}"
                    ShowSelectedFootprintVMTemplate="{StaticResource ShowSelectedFootprintToolbarTemplate}"
                    ShowUnselectedFootprintsVMTemplate="{StaticResource ShowUnselectedFootprintsToolbarTemplate}" />
            </Setter.Value>
        </Setter>

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="controls:OrientedImageryView">
                    <Border
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <ItemsControl x:Name="PART_ToolbarContainer" IsTabStop="False" Style="{StaticResource ToolbarContainerStyle}" />

                            <Grid Grid.Row="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <controls:OrientedImageViewport
                                    x:Name="PART_ImageViewport"
                                    Grid.ColumnSpan="3"
                                    DisplayBackgroundColor="{TemplateBinding DisplayBackgroundColor}" />

                                        <Border
                                    Grid.ColumnSpan="3"
                                    Background="#80FFFFFF"
                                    Visibility="{x:Bind local:OrientedImageryResources.VisibleWhenLoading(ViewModel.SelectedImage, IsImageViewportInteractive), Mode=OneWay}">
                                            <TextBlock
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Text="{internal:LocalizedString Key=OrientedImageryViewLoading}" />
                                </Border>

                                <ProgressBar
                                    Grid.ColumnSpan="3"
                                    Height="2"
                                    VerticalAlignment="Top"
                                    IsIndeterminate="True"
                                    Visibility="{x:Bind local:OrientedImageryResources.VisibleWhenBusy(ViewModel.SelectedImage, IsImageViewportBusy), Mode=OneWay}" />

                                <Border
                                    Grid.ColumnSpan="3"
                                    Background="{ThemeResource OrientedImageryOverlayBackgroundBrush}"
                                    Visibility="{TemplateBinding NoImageSelectedVisibility}">
                                    <TextBlock
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Text="{internal:LocalizedString Key=OrientedImageryViewNoImageToDisplay}" />
                                </Border>

                                <Border
                                    Grid.ColumnSpan="3"
                                    MaxWidth="300"
                                    Padding="8"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Background="{ThemeResource OrientedImageryOverlayBackgroundBrush}"
                                    BorderBrush="{ThemeResource OrientedImageryOverlayBorderBrush}"
                                    BorderThickness="1"
                                    Visibility="{x:Bind ImageViewportErrorVisibility, Mode=OneWay}">
                                    <TextBlock Text="{x:Bind ImageViewportErrorMessage, Mode=OneWay}" TextWrapping="Wrap" />
                                </Border>

                                <Button
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    Command="{x:Bind ViewModel.SelectPreviousImageCommand, Mode=OneWay}"
                                    Style="{StaticResource OrientedImageryNavigationButtonStyle}"
                                    Visibility="{TemplateBinding ImageNavigationVisibility}"
                                    AutomationProperties.Name="{internal:LocalizedString Key=OrientedImageryViewPreviousImage}"
                                    ToolTipService.ToolTip="{internal:LocalizedString Key=OrientedImageryViewPreviousImage}">
                                    <Viewbox Width="20" Height="20" Stretch="Uniform">
                                        <PathIcon Data="M20 26.1 9.9 16 20 5.9z" />
                                    </Viewbox>
                                </Button>

                                <Button
                                    Grid.Column="2"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    Command="{x:Bind ViewModel.SelectNextImageCommand, Mode=OneWay}"
                                    Style="{StaticResource OrientedImageryNavigationButtonStyle}"
                                    Visibility="{TemplateBinding ImageNavigationVisibility}"
                                    AutomationProperties.Name="{internal:LocalizedString Key=OrientedImageryViewNextImage}"
                                    ToolTipService.ToolTip="{internal:LocalizedString Key=OrientedImageryViewNextImage}">
                                    <Viewbox Width="20" Height="20" Stretch="Uniform">
                                        <PathIcon Data="M12 5.9 22.1 16 12 26.1z" />
                                    </Viewbox>
                                </Button>
                            </Grid>

                            <controls:OrientedImageryPaginator
                                x:Name="PART_Paginator"
                                Grid.Row="2"
                                HorizontalAlignment="Stretch"
                                Style="{StaticResource OrientedImageryPaginatorStyle}"
                                Visibility="{TemplateBinding ResultNavigationVisibility}" />

                            <StackPanel
                                Grid.Row="2"
                                HorizontalAlignment="Center"
                                Orientation="Horizontal"
                                Visibility="{TemplateBinding SequentialNavigationVisibility}">
                                <Button
                                    Style="{StaticResource OrientedImageryPageButtonStyle}"
                                    IsTabStop="False"
                                    Width="33"
                                    Command="{x:Bind ViewModel.SelectPreviousImageCommand, Mode=OneWay}"
                                    ToolTipService.ToolTip="{internal:LocalizedString Key=OrientedImageryViewPreviousImage}"
                                    AutomationProperties.Name="{internal:LocalizedString Key=OrientedImageryViewPreviousImage}">
                                    <FontIcon Glyph="&#xe79f;" FontFamily="{StaticResource toolkit-icons}" FontSize="16" />
                                </Button>
                                <Button
                                    Content="{internal:LocalizedString Key=OrientedImageryViewPreviousLabel}"
                                    AutomationProperties.Name="{internal:LocalizedString Key=OrientedImageryViewPreviousImage}"
                                    ToolTipService.ToolTip="{internal:LocalizedString Key=OrientedImageryViewPreviousImage}"
                                    Style="{StaticResource OrientedImageryPageButtonStyle}"
                                    Command="{x:Bind ViewModel.SelectPreviousImageCommand, Mode=OneWay}" />
                                <Grid Width="35" Height="32">
                                    <TextBlock Text="." HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    <Border
                                        Height="2"
                                        Margin="1,0"
                                        VerticalAlignment="Bottom"
                                        Background="{ThemeResource OrientedImageryPageSelectedBrush}" />
                                </Grid>
                                <Button
                                    Content="{internal:LocalizedString Key=OrientedImageryViewNextLabel}"
                                    AutomationProperties.Name="{internal:LocalizedString Key=OrientedImageryViewNextImage}"
                                    ToolTipService.ToolTip="{internal:LocalizedString Key=OrientedImageryViewNextImage}"
                                    Style="{StaticResource OrientedImageryPageButtonStyle}"
                                    Command="{x:Bind ViewModel.SelectNextImageCommand, Mode=OneWay}" />
                                <Button
                                    Style="{StaticResource OrientedImageryPageButtonStyle}"
                                    IsTabStop="False"
                                    Width="33"
                                    Command="{x:Bind ViewModel.SelectNextImageCommand, Mode=OneWay}"
                                    ToolTipService.ToolTip="{internal:LocalizedString Key=OrientedImageryViewNextImage}"
                                    AutomationProperties.Name="{internal:LocalizedString Key=OrientedImageryViewNextImage}">
                                    <FontIcon Glyph="&#xe7a0;" FontFamily="{StaticResource toolkit-icons}" FontSize="16" />
                                </Button>
                            </StackPanel>
                            <TextBlock
                                Grid.Row="3"
                                Margin="8,0,8,4"
                                Text="{x:Bind ViewModel.SequentialNavigationError, Mode=OneWay}"
                                TextAlignment="Center"
                                TextWrapping="Wrap"
                                Visibility="{x:Bind local:OrientedImageryResources.VisibleWhenNotNull(ViewModel.SequentialNavigationError), Mode=OneWay}" />
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
