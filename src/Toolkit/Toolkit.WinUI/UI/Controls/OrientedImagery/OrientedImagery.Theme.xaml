    <DataTemplate x:Key="ImageSearchModeToolbarTemplate" x:DataType="controls:ImageSearchModeVM">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ToggleButton
                IsChecked="{x:Bind IsImageSelectionEnabled, Mode=TwoWay}"
                MinWidth="0" MinHeight="84" Padding="0,4"
                Style="{StaticResource OrientedImageryToolbarToggleButtonStyle}"
                AutomationProperties.Name="{internal:LocalizedString Key=OrientedImageryViewImageSearchMode}"
                ToolTipService.ToolTip="{internal:LocalizedString Key=OrientedImageryViewImageSearchMode}">
                <StackPanel Spacing="8">
                    <Viewbox Width="32" Height="32" Stretch="Uniform">
                        <ContentControl
                            Content="{x:Bind}"
                            ContentTemplate="{StaticResource ImageSearchModeIconTemplate}"
                            IsTabStop="False" />
                    </Viewbox>
                    <TextBlock
                        Width="48" Height="32" FontSize="12"
                        TextAlignment="Center" TextWrapping="Wrap"
                        Text="{x:Bind local:OrientedImageryResources.ImageSearchModeLabel(SelectedInteractionState), Mode=OneWay}" />
                </StackPanel>
            </ToggleButton>
            <ComboBox
                Grid.Column="1"
                Style="{StaticResource ImageSearchModeComboBoxStyle}"
                ItemsSource="{x:Bind ImageSearchModes}"
                SelectedItem="{x:Bind SelectedInteractionState, Mode=TwoWay}"
                AutomationProperties.Name="{internal:LocalizedString Key=OrientedImageryViewImageSearchMode}"
                ToolTipService.ToolTip="{internal:LocalizedString Key=OrientedImageryViewImageSearchMode}">
                <ComboBox.ItemContainerStyle>
                    <Style TargetType="ComboBoxItem">
                        <Setter Property="local:ImageSearchModeSelectionBehavior.RepeatSelection" Value="True" />
                        <Setter Property="MinHeight" Value="40" />
                        <Setter Property="Padding" Value="8,4" />
                    </Style>
                </ComboBox.ItemContainerStyle>
                <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="controls:OrientedImageryViewInteractionState">
                        <TextBlock Text="{x:Bind Converter={StaticResource ImageSearchModeLabelConverter}}" />
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
        </Grid>
    </DataTemplate>

